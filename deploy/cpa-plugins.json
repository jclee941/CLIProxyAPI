{
  "core": {
    "paths": ["cmd", "internal", "sdk", "go.mod", "go.sum", ":(exclude)*.md", ":(exclude)*_test.go", ":(exclude,glob)**/testdata/**"],
    "release": "https://github.com/jclee941/CLIProxyAPI/releases/download/cpa-core",
    "asset": "CLIProxyAPI"
  },
  "plugins": [
    {"id": "gemini-web", "artifact": "deploy/gemini-web-plugin/gemini-web.so", "reload": "restart"},
    {"id": "chatgpt-web", "artifact": "deploy/chatgpt-web-plugin/chatgpt-web.so", "reload": "hot"},
    {"id": "flow2api", "artifact": "deploy/flow2api-plugin/flow2api.so", "reload": "hot"}
  ],
  "files": [
    {"artifact": "deploy/gemini-web-plugin/web/index.html", "target": "gemini-web/index.html"},
    {"artifact": "deploy/gemini-web-plugin/browser-extension/artifacts/gemini-web-login-companion-0.2.0.zip", "target": "gemini-web/gemini-web-login-companion.zip"},
    {"artifact": "deploy/flow2api-plugin/web/index.html", "target": "flow2api/index.html"},
    {"artifact": "deploy/chatgpt-web-plugin/web/index.html", "target": "chatgpt-web/index.html"}
  ]
}
