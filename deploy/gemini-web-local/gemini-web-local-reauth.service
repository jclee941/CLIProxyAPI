[Unit]
Description=Re-authenticate local Gemini accounts whose credential failed authentication
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
RuntimeDirectory=gemini-web-local-reauth
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/python3 /opt/dashboard/gemini-web-local/reauth-production.py
TimeoutStartSec=infinity
Restart=no
