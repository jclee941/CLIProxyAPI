# Telegram bot token issued by @BotFather.
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram chat IDs allowed to talk to the bot.
# Every update from a chat outside this allowlist is dropped.
TELEGRAM_ALLOWED_CHAT_IDS=

# CLIProxyAPI management base URL as seen from inside the container.
# Default assumes CPA publishes 8317 on the Docker host; the compose file
# maps host.docker.internal to the host gateway for this to resolve.
# Alternative: http://127.0.0.1:8317 only works when the container shares the
# host network (network_mode: host), which disables the compose bridge network
# and the extra_hosts entry. Prefer the default unless CPA is bound to loopback
# only and cannot be reached through the host gateway.
CPA_BASE_URL=http://host.docker.internal:8317

# CLIProxyAPI management key used for the management API calls the bot makes.
CPA_MANAGEMENT_KEY=

# Long-poll timeout in seconds for Telegram getUpdates.
TELEGRAM_POLL_TIMEOUT_SECONDS=30

# Local time of the scheduled daily usage report (HH:MM, container TZ).
REPORT_TIME=09:00

# Set to false to disable the scheduled daily report and keep only on-demand buttons.
REPORT_ENABLED=true

# Persisted bot state (last report date, last processed update offset).
STATE_PATH=/state/telegram-usage-bot.json
