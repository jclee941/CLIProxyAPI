@@ -0,0 +1,23 @@
+import { describe, expect, it } from 'vitest';
+import { splitLogPayloads } from './logPayloads';
+
+describe('request log payload boundaries', () => {
+  it('preserves exact payload text without JSON parsing or headers', () => {
+    const request = '{"integer":9007199254740993,"prompt":"=== RESPONSE ===\\nquoted"}\n\n\n';
+    const response = 'event: error\ndata: {"error":{"message":"failed"}}\n\n';
+    const log = '=== REQUEST INFO ===\nMethod: POST\n\n=== HEADERS ===\nAuthorization: ***\n\n' +
+      '=== REQUEST BODY ===\n' + request +
+      '=== API ERROR RESPONSE ===\nHTTP Status: 429\nupstream retry\n\n' +
+      '=== RESPONSE ===\nStatus: 422\nContent-Type: text/event-stream\n\n' + response;
+    expect(splitLogPayloads(log)).toEqual({ request, response });
+  });
+
+  it('does not invent payloads for unstructured logs', () => {
+    expect(splitLogPayloads('plain error log')).toEqual({ request: null, response: null });
+  });
+
+  it('supports CRLF framing and an empty captured body', () => {
+    const log = '=== REQUEST BODY ===\r\n\r\n=== RESPONSE ===\r\nStatus: 204\r\n\r\n';
+    expect(splitLogPayloads(log)).toEqual({ request: '\r\n', response: '' });
+  });
+});
diff --git c/apps/web/src/features/logs/logPayloads.ts i/apps/web/src/features/logs/logPayloads.ts
new file mode 100644
index 0000000..4754103
--- /dev/null
+++ i/apps/web/src/features/logs/logPayloads.ts
@@ -0,0 +1,25 @@
+export interface LogPayloads {
+  request: string | null;
+  response: string | null;
+}
+
+// Preserve captured text, including large integers and SSE frames. The original
+// log remains available when a legacy or incomplete file has no body framing.
+export function splitLogPayloads(log: string): LogPayloads {
+  const sections = [...log.matchAll(/^=== ([A-Z][A-Z ]*) ===\r?$/gm)];
+  let request: string | null = null;
+  let response: string | null = null;
+  sections.forEach((section, index) => {
+    let start = section.index + section[0].length;
+    if (log[start] === '\n') start += 1;
+    const content = log.slice(start, sections[index + 1]?.index ?? log.length);
+    if (section[1] === 'REQUEST BODY' && request === null) {
+      request = content;
+    }
+    if (section[1] === 'RESPONSE') {
+      const separator = /\r?\n\r?\n/.exec(content);
+      if (separator) response = content.slice(separator.index + separator[0].length);
+    }
+  });
+  return { request, response };
+}
