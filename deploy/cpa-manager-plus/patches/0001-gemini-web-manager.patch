diff --git c/apps/web/src/features/plugins/chatgptHostPolicy.ts i/apps/web/src/features/plugins/chatgptHostPolicy.ts
new file mode 100644
index 0000000..2df6ba2
--- /dev/null
+++ i/apps/web/src/features/plugins/chatgptHostPolicy.ts
@@ -0,0 +1,38 @@
+import { isRecord } from '@/utils/helpers';
+
+export const chatgptErrorCodes: ReadonlySet<string> = new Set([
+  'invalid_management_request', 'invalid_account_request', 'invalid_import_request_require_consent',
+  'invalid_web_account_id', 'invalid_web_enabled_request_require_consent', 'source_not_found', 'not_found', 'method_not_allowed',
+  'source_metadata_unavailable', 'source_credential_invalid', 'disabled_source_requires_override',
+  'vendor_disabled_import_unsupported', 'vendor_disabled_refresh_unsupported', 'vendor_web_enabled_unsupported',
+  'web_account_status_unknown', 'web_account_stale_reload_needed', 'web_api_unavailable',
+  'web_api_http_error', 'web_api_redirect_blocked', 'web_api_invalid_response',
+  'web_api_response_too_large', 'vendor_refresh_failed', 'vendor_disabled_contract_violated', 'vendor_web_enabled_contract_violated',
+  'host_callback_required', 'host_auth_unavailable',
+  'web_api_unconfigured_set_CHATGPT2API_AUTH_KEY', 'request_cancelled',
+  'host_request_encoding_failed', 'request_encoding_failed', 'response_encoding_failed',
+]);
+
+export function allowChatGPTPost(path: string, body: unknown): boolean {
+  if (typeof body !== 'string' || new TextEncoder().encode(body).byteLength > 4096) return false;
+  try {
+    const input: unknown = JSON.parse(body);
+    if (!isRecord(input) || typeof input.id !== 'string') return false;
+    const keys = Object.keys(input);
+    switch (path) {
+      case '/v0/management/plugins/chatgpt2api/import-codex':
+        return /^codex_[a-f0-9]{64}$/.test(input.id) && input.consent === true &&
+          (input.allow_disabled_source === undefined || input.allow_disabled_source === true) &&
+          keys.every((key) => ['id', 'consent', 'allow_disabled_source'].includes(key));
+      case '/v0/management/plugins/chatgpt2api/refresh-web':
+        return /^web_[a-f0-9]{64}$/.test(input.id) && keys.length === 1;
+      case '/v0/management/plugins/chatgpt2api/set-web-enabled':
+        return /^web_[a-f0-9]{64}$/.test(input.id) && input.consent === true &&
+          typeof input.enabled === 'boolean' && keys.every((key) => ['id', 'enabled', 'consent'].includes(key));
+      default:
+        return false;
+    }
+  } catch {
+    return false;
+  }
+}
