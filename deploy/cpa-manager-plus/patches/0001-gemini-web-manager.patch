+import { describe, expect, it } from 'vitest';
+import type { GeminiWebAccount } from '@/services/api/geminiWebDto';
+import { GEMINI_WEB_CONFIG, preserveGeminiWebObservation } from './geminiWebQuotaConfig';
+
+const account: GeminiWebAccount = {
+  id: 'gemini-web-fixture-1.json',
+  label: 'Fixture',
+  enabled: false,
+  status: 'ready',
+  models: [{ id: 'fixture-model', name: 'Fixture model' }],
+  observed_at: 1800000000,
+  usage: {
+    tier: null,
+    tier_code: 'opaque-42',
+    metrics: [],
+    source: 'GoogleWeb',
+    estimated: false,
+    observed_at: 1800000000,
+  },
+};
+describe('GeminiWeb manual quota adapter', () => {
+  it('retains the provider DTO instead of Codex windows when loaded', () => {
+    const result = GEMINI_WEB_CONFIG.buildSuccessState(account);
+    expect(GEMINI_WEB_CONFIG.type).toBe('gemini-web');
+    expect(result.account).toEqual(account);
+    expect(result).not.toHaveProperty('windows');
+    expect(result).not.toHaveProperty('planType');
+    expect(result).not.toHaveProperty('usedPercent');
+  });
+  it.each(['error', 'expired', 'unknown'] as const)(
+    'does not mark %s as success for HTTP 200',
+    (status) => {
+      const result = GEMINI_WEB_CONFIG.buildSuccessState({ ...account, status, usage: null });
+      expect(result.status).not.toBe('success');
+      expect(result.account?.usage).toBeNull();
+    }
+  );
+  it('keeps missing usage unknown even when models are ready', () => {
+    expect(GEMINI_WEB_CONFIG.buildSuccessState({ ...account, usage: null }).status).toBe('unknown');
+  });
+  it('marks the previous observation stale on body-level failure', () => {
+    const previous = GEMINI_WEB_CONFIG.buildSuccessState(account);
+    const failure = GEMINI_WEB_CONFIG.buildSuccessState({
+      ...account,
+      status: 'expired',
+      usage: null,
+      error: 'session_expired',
+    });
+    const result = preserveGeminiWebObservation(previous, failure);
+    expect(result.status).toBe('error');
+    expect(result.stale).toBe(true);
+    expect(result.account?.usage?.observed_at).toBe(1800000000);
+    expect(result.error).toContain('expired');
+  });
+  it('marks the previous observation stale on transport failure', () => {
+    const previous = GEMINI_WEB_CONFIG.buildSuccessState(account);
+    const result = preserveGeminiWebObservation(
+      previous,
+      GEMINI_WEB_CONFIG.buildErrorState('Unavailable')
+    );
+    expect(result.status).toBe('error');
+    expect(result.stale).toBe(true);
+    expect(result.account).toEqual(account);
+  });
+  it('replaces stale data with explicit nulls on the next non-error observation', () => {
+    const previous = { ...GEMINI_WEB_CONFIG.buildSuccessState(account), stale: true };
+    const next = GEMINI_WEB_CONFIG.buildSuccessState({ ...account, usage: null });
+    expect(preserveGeminiWebObservation(previous, next)).toEqual(next);
+  });
+});
