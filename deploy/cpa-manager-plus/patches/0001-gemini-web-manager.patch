+++ i/apps/web/src/features/plugins/chatgptHostRequest.test.ts
@@ -0,0 +1,56 @@
+import { describe, expect, it } from 'vitest';
+import { allowPluginRequest, safePluginError } from './pluginHostRequest';
+
+const prefix = '/v0/management/plugins/chatgpt2api/';
+const sourceID = `codex_${'a'.repeat(64)}`;
+const webID = `web_${'b'.repeat(64)}`;
+const accounts = new Set<string>();
+const allowed = [
+  ['import-codex', { id: sourceID, consent: true }],
+  ['import-codex', { id: sourceID, consent: true, allow_disabled_source: true }],
+  ['refresh-web', { id: webID }],
+  ['set-web-enabled', { id: webID, enabled: true, consent: true }],
+  ['set-web-enabled', { id: webID, enabled: false, consent: true }],
+] as const;
+
+describe('ChatGPT scoped POST policy', () => {
+  it.each(allowed)('allows only the exact %s request shape', (path, payload) => {
+    const input = { path: `${prefix}${path}`, method: 'POST', body: JSON.stringify(payload) };
+    expect(allowPluginRequest('chatgpt2api', input, accounts)).toBe(true);
+    expect(allowPluginRequest('gemini-web', input, accounts)).toBe(false);
+  });
+  it.each(['status', 'accounts', 'refresh', 'login/start', 'import-codex/other', 'refresh-web/', 'set-web-enabled?x=1', '../config', '%72efresh-web'])('blocks arbitrary POST %s', (path) => {
+    expect(allowPluginRequest('chatgpt2api', { path: `${prefix}${path}`, method: 'POST', body: JSON.stringify({ id: webID }) }, accounts)).toBe(false);
+  });
+  it.each([
+    ['import-codex', { id: sourceID }],
+    ['import-codex', { id: sourceID, consent: false }],
+    ['import-codex', { id: sourceID, consent: true, allow_disabled_source: false }],
+    ['import-codex', { id: webID, consent: true }],
+    ['refresh-web', { id: sourceID }],
+    ['refresh-web', { id: webID, token: 'synthetic-not-accepted' }],
+    ['refresh-web', { id: [webID] }],
+    ['set-web-enabled', { id: webID, enabled: true }],
+    ['set-web-enabled', { id: webID, enabled: 'false', consent: true }],
+    ['set-web-enabled', { id: webID, enabled: false, consent: false }],
+  ])('blocks invalid body for %s', (path, payload) => {
+    expect(allowPluginRequest('chatgpt2api', { path: `${prefix}${path}`, method: 'POST', body: JSON.stringify(payload) }, accounts)).toBe(false);
+  });
+  it.each([undefined, '', 'null', '[]', '{', ' '.repeat(4096) + JSON.stringify({ id: webID })])('blocks missing, malformed and oversized bodies', (body) => {
+    expect(allowPluginRequest('chatgpt2api', { path: `${prefix}refresh-web`, method: 'POST', body }, accounts)).toBe(false);
+  });
+  it('preserves GET status and rejects headers, generic management and cross-plugin POST', () => {
+    expect(allowPluginRequest('chatgpt2api', { path: `${prefix}status`, method: 'GET' }, accounts)).toBe(true);
+    for (const path of ['/v0/management/config', '/v0/management/plugins/gemini-web/refresh']) {
+      expect(allowPluginRequest('chatgpt2api', { path, method: 'POST', body: JSON.stringify({ id: webID }) }, accounts)).toBe(false);
+    }
+    expect(allowPluginRequest('chatgpt2api', { path: `${prefix}refresh-web`, method: 'POST', body: JSON.stringify({ id: webID }), headers: { Authorization: 'synthetic' } }, accounts)).toBe(false);
+  });
+  it('preserves only fixed ChatGPT codes in that plugin scope', () => {
+    const body = JSON.stringify({ error: 'web_account_stale_reload_needed', config: { key: 'synthetic-private' } });
+    expect(safePluginError(body, 'chatgpt2api')).toBe('web_account_stale_reload_needed');
+    expect(safePluginError(body)).toBeUndefined();
+    expect(safePluginError('{"error":"account_unavailable"}', 'chatgpt2api')).toBeUndefined();
+    expect(safePluginError('{"error":"synthetic-private"}', 'chatgpt2api')).toBeUndefined();
+  });
+});
