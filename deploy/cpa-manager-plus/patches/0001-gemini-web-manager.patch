+import { geminiWebApi } from '@/services/api/geminiWeb';
+import type { GeminiWebAccount } from '@/services/api/geminiWebDto';
+import type { QuotaConfig } from './quotaConfigs';
+
+export type GeminiWebQuotaState = {
+  readonly status: 'idle' | 'loading' | 'success' | 'error' | 'unknown';
+  readonly account: GeminiWebAccount | null;
+  readonly stale: boolean;
+  readonly error?: string;
+};
+
+export const GEMINI_WEB_CONFIG: QuotaConfig<GeminiWebQuotaState, GeminiWebAccount> = {
+  type: 'gemini-web',
+  i18nPrefix: 'gemini_web',
+  fetchQuota: (file, _translate, scope) => geminiWebApi.refresh(file, scope),
+  buildLoadingState: () => ({ status: 'loading', account: null, stale: false }),
+  buildErrorState: (error) => ({ status: 'error', account: null, stale: false, error }),
+  buildSuccessState: (account) => {
+    switch (account.status) {
+      case 'error':
+      case 'expired':
+        return {
+          status: 'error',
+          account,
+          stale: false,
+          error: `${account.status}: ${account.error || 'account_check_failed'}`,
+        };
+      case 'unknown':
+        return { status: 'unknown', account, stale: false };
+      case 'ready':
+        return { status: account.usage ? 'success' : 'unknown', account, stale: false };
+    }
+  },
+};
+
+export function preserveGeminiWebObservation(
+  previous: GeminiWebQuotaState,
+  next: GeminiWebQuotaState
+): GeminiWebQuotaState {
+  if (next.status === 'error' && previous.account?.usage) {
+    return { ...next, account: previous.account, stale: true };
+  }
+  return next;
+}
