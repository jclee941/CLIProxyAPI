+import { isRecord } from '@/utils/helpers';
+
+export type GeminiWebMetric = {
+  readonly remaining_units: number | null;
+  readonly usage_fraction: number | null;
+  readonly usage_percent?: number;
+  readonly reset_unix_seconds: number | null;
+  readonly window_kind: '5h' | 'weekly' | 'ai_credit' | 'unknown';
+  readonly unit: 'provider_compute_unit';
+  readonly metric_type?: string | number;
+};
+export type GeminiWebUsage = {
+  readonly tier: string | null;
+  readonly tier_code: number | string | null;
+  readonly metrics: readonly GeminiWebMetric[] | null;
+  readonly source: 'GoogleWeb';
+  readonly estimated: false;
+  readonly observed_at: number;
+};
+export type GeminiWebAccount = {
+  readonly id: string;
+  readonly label: string;
+  readonly enabled: boolean;
+  readonly status: 'ready' | 'expired' | 'error' | 'unknown';
+  readonly models: readonly { readonly id: string; readonly name: string }[];
+  readonly usage: GeminiWebUsage | null;
+  readonly error?: string;
+  readonly observed_at: number;
+};
+
+export class GeminiWebError extends Error {
+  readonly name = 'GeminiWebError';
+}
+
+function numberOrNull(value: unknown): number | null {
+  if (value === null || (typeof value === 'number' && Number.isFinite(value))) return value;
+  throw new GeminiWebError('Invalid GeminiWeb measurement. Check the plugin version.');
+}
+function timestamp(value: unknown): number {
+  const result = numberOrNull(value);
+  if (result !== null && result > 0 && result <= 8.64e12) return result;
+  throw new GeminiWebError('Invalid GeminiWeb observation time. Check the plugin version.');
+}
+function textOrNull(value: unknown): string | null {
+  if (value === null || typeof value === 'string') return value;
+  throw new GeminiWebError('Invalid GeminiWeb text field. Check the plugin version.');
+}
+function parseMetric(value: unknown): GeminiWebMetric {
+  if (!isRecord(value) || value.unit !== 'provider_compute_unit') {
+    throw new GeminiWebError('Unsupported GeminiWeb metric. Open the plugin panel for details.');
+  }
+  const window = value.window_kind;
+  if (window !== '5h' && window !== 'weekly' && window !== 'ai_credit' && window !== 'unknown') {
+    throw new GeminiWebError('Invalid GeminiWeb window.');
+  }
+  const percent = value.usage_percent === undefined ? undefined : numberOrNull(value.usage_percent);
+  if (
+    percent === null ||
+    (value.metric_type !== undefined &&
+      typeof value.metric_type !== 'string' &&
+      typeof value.metric_type !== 'number')
+  ) {
+    throw new GeminiWebError('Invalid GeminiWeb metric details.');
+  }
+  return {
+    remaining_units: numberOrNull(value.remaining_units),
+    usage_fraction: numberOrNull(value.usage_fraction),
+    ...(percent !== undefined ? { usage_percent: percent } : {}),
+    reset_unix_seconds:
+      value.reset_unix_seconds === null ? null : timestamp(value.reset_unix_seconds),
+    window_kind: window,
+    unit: 'provider_compute_unit',
+    ...(value.metric_type !== undefined ? { metric_type: value.metric_type } : {}),
+  };
+}
+function parseUsage(value: unknown): GeminiWebUsage | null {
+  if (value === null) return null;
+  if (
+    !isRecord(value) ||
+    value.source !== 'GoogleWeb' ||
+    value.estimated !== false ||
+    (value.metrics !== null && !Array.isArray(value.metrics))
+  ) {
+    throw new GeminiWebError('Invalid GeminiWeb usage response. Check the plugin version.');
+  }
+  const tierCode = value.tier_code;
+  if (
+    tierCode !== null &&
+    typeof tierCode !== 'string' &&
+    !(typeof tierCode === 'number' && Number.isFinite(tierCode))
+  ) {
+    throw new GeminiWebError('Invalid GeminiWeb tier code.');
+  }
+  return {
+    tier: textOrNull(value.tier),
+    tier_code: tierCode,
+    metrics: value.metrics === null ? null : value.metrics.map(parseMetric),
+    source: 'GoogleWeb',
+    estimated: false,
+    observed_at: timestamp(value.observed_at),
+  };
+}
+export function parseGeminiWebAccount(value: unknown): GeminiWebAccount {
+  if (
+    !isRecord(value) ||
+    typeof value.id !== 'string' ||
+    typeof value.label !== 'string' ||
+    typeof value.enabled !== 'boolean' ||
+    !Array.isArray(value.models) ||
+    (value.error !== undefined && typeof value.error !== 'string')
+  ) {
+    throw new GeminiWebError('Invalid GeminiWeb account response. Check the plugin version.');
+  }
+  const status = value.status;
+  if (status !== 'ready' && status !== 'expired' && status !== 'error' && status !== 'unknown') {
+    throw new GeminiWebError('Invalid GeminiWeb account state.');
+  }
+  return {
+    id: value.id,
+    label: value.label,
+    enabled: value.enabled,
+    status,
+    models: value.models.map((model: unknown) => {
+      if (!isRecord(model) || typeof model.id !== 'string' || typeof model.name !== 'string') {
+        throw new GeminiWebError('Invalid GeminiWeb model response.');
+      }
+      return { id: model.id, name: model.name };
+    }),
+    usage: parseUsage(value.usage),
+    observed_at: timestamp(value.observed_at),
+    ...(value.error !== undefined ? { error: value.error } : {}),
+  };
+}
