@@ -0,0 +1,101 @@
+import type { AuthFileItem } from '@/types';
+import { isRecord } from '@/utils/helpers';
+import { normalizeApiBase } from '@/utils/connection';
+import { apiClient, createScopedApiRequestConfig, type ApiClientRequestScope } from './client';
+import { pluginsApi } from './plugins';
+import { GeminiWebError, parseGeminiWebAccount } from './geminiWebDto';
+
+const resourcePath = '/v0/resource/plugins/gemini-web/index';
+export const GEMINI_WEB_PORTAL_ROUTE = '/plugin-pages/gemini-web/0';
+
+export function geminiWebAccountId(file: AuthFileItem): string {
+  if (
+    (file.provider || file.type) !== 'gemini-web' ||
+    (file.type && file.type !== 'gemini-web') ||
+    !/^gemini-web-[a-z0-9-]+\.json$/.test(file.name) ||
+    (file.id && file.id !== file.name)
+  ) {
+    throw new GeminiWebError(
+      'GeminiWeb account identity does not match its provider filename. Open the plugin panel.'
+    );
+  }
+  return file.name;
+}
+
+export async function requireGeminiWebPortal(scope: ApiClientRequestScope): Promise<string> {
+  const response = await pluginsApi.list(scope);
+  const plugin = response.plugins.find((entry) => entry.id === 'gemini-web');
+  if (
+    !response.pluginsEnabled ||
+    !plugin?.registered ||
+    !plugin.effectiveEnabled ||
+    plugin.menus[0]?.path !== resourcePath
+  ) {
+    throw new GeminiWebError(
+      'GeminiWeb portal is unavailable. Check that the GeminiWeb plugin is enabled and its first resource page is installed.'
+    );
+  }
+  const resource = await apiClient.getRaw(resourcePath, {
+    ...createScopedApiRequestConfig(scope),
+    baseURL: normalizeApiBase(scope.apiBase),
+    responseType: 'text',
+  });
+  if (
+    !String(resource.headers['content-type']).includes('text/html') ||
+    typeof resource.data !== 'string' ||
+    !resource.data.trim()
+  ) {
+    throw new GeminiWebError(
+      'GeminiWeb portal did not return HTML. Check the plugin resource installation.'
+    );
+  }
+  return GEMINI_WEB_PORTAL_ROUTE;
+}
+
+export function geminiWebErrorMessage(error: unknown): string {
+  if (error instanceof GeminiWebError) return error.message;
+  if (isRecord(error) && (error.status === 401 || error.status === 403)) {
+    return 'Manager authorization failed. Sign in to Manager again and check plugin access.';
+  }
+  return 'GeminiWeb request failed. Check the plugin and its resource installation, then retry.';
+}
+
+export const geminiWebApi = {
+  async load(file: AuthFileItem, scope?: ApiClientRequestScope) {
+    const id = geminiWebAccountId(file);
+    const response = await apiClient.get(
+      '/plugins/gemini-web/accounts',
+      scope ? createScopedApiRequestConfig(scope) : undefined
+    );
+    if (
+      !isRecord(response) ||
+      response.provider !== 'gemini-web' ||
+      !Array.isArray(response.accounts)
+    ) {
+      throw new GeminiWebError('Invalid GeminiWeb account list. Check the plugin version.');
+    }
+    const matches = response.accounts.filter(
+      (account: unknown) => isRecord(account) && account.id === id
+    );
+    if (matches.length !== 1) {
+      throw new GeminiWebError(
+        'No unique GeminiWeb account matches this filename. Open the plugin panel to check registration.'
+      );
+    }
+    return parseGeminiWebAccount(matches[0]);
+  },
+  async refresh(file: AuthFileItem, scope?: ApiClientRequestScope) {
+    const id = geminiWebAccountId(file);
+    const response = await apiClient.post(
+      '/plugins/gemini-web/refresh',
+      { id },
+      scope ? createScopedApiRequestConfig(scope) : undefined
+    );
+    const account = parseGeminiWebAccount(response);
+    if (account.id !== id)
+      throw new GeminiWebError(
+        'GeminiWeb returned a different account. No measurements were applied.'
+      );
+    return account;
+  },
+};
