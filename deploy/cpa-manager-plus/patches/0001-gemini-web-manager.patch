+import { afterEach, describe, expect, it, vi } from 'vitest';
+import type { TFunction } from 'i18next';
+import type { AuthFileItem } from '@/types';
+import { apiClient } from '@/services/api/client';
+import {
+  fetchPluginQuota,
+  formatPluginQuotaMetric,
+  isPluginQuotaFile,
+  parsePluginQuota,
+} from './pluginQuota';
+
+const t = ((key: string) => key) as TFunction;
+
+describe('plugin quota adapter', () => {
+  afterEach(() => {
+    vi.restoreAllMocks();
+  });
+
+  it('reads CPA plugin quota for plugin providers and leaves built-in adapters alone', () => {
+    const file = (fields: Partial<AuthFileItem>) =>
+      ({ name: 'credential.json', ...fields }) as AuthFileItem;
+    expect(isPluginQuotaFile(file({ provider: 'gemini-web', supports_quota: true }))).toBe(true);
+    expect(isPluginQuotaFile(file({ type: 'flow2api', supports_quota: true }))).toBe(true);
+    expect(isPluginQuotaFile(file({ provider: 'codex', supports_quota: true }))).toBe(false);
+    expect(isPluginQuotaFile(file({ provider: 'gemini-web' }))).toBe(false);
+  });
+
+  it('parses window buckets and summary metrics from the normalized CPA response', () => {
+    const quota = parsePluginQuota({
+      subscription: { tierId: '3' },
+      groups: [
+        {
+          displayName: 'Google Web',
+          buckets: [
+            { window: 'weekly', remainingFraction: 0.2, resetTime: '2026-10-19T03:58:48Z' },
+            { window: '5h', remainingFraction: 0.71, resetTime: '2026-10-18T19:58:48Z' },
+            null,
+          ],
+        },
+        'not a group',
+      ],
+      summary: [
+        { key: 'credits', label: 'Flow credits', value: 24470, unit: 'credits', format: 'number' },
+        { key: 'unread', value: 'NaN' },
+      ],
+    });
+
+    expect(quota?.subscription).toEqual({ plan: null, tierName: null, tierId: '3' });
+    expect(
+      quota?.groups.map((group) =>
+        group.buckets.map((bucket) => [bucket.window, bucket.label, bucket.remainingFraction])
+      )
+    ).toEqual([
+      [
+        ['5h', '5h', 0.71],
+        ['weekly', 'weekly', 0.2],
+      ],
+    ]);
+    expect(quota?.summary).toEqual([
+      { key: 'credits', label: 'Flow credits', value: 24470, unit: 'credits', format: 'number' },
+    ]);
+    expect(parsePluginQuota('not a quota')).toBeNull();
+  });
+
+  it('posts the credential auth index to the CPA quota route', async () => {
+    const post = vi.spyOn(apiClient, 'post').mockResolvedValue({
+      summary: [{ key: 'credits', label: 'Flow credits', value: 5, unit: 'credits' }],
+    });
+
+    const quota = await fetchPluginQuota(
+      { name: 'flow2api-a.json', provider: 'flow2api', auth_index: 'auth-flow' } as AuthFileItem,
+      t
+    );
+
+    expect(post).toHaveBeenCalledWith('/quota/fetch', { auth_index: 'auth-flow' }, undefined);
+    expect(quota.summary.map((metric) => metric.value)).toEqual([5]);
+  });
+
+  it('refuses a credential without an auth index before calling CPA', async () => {
+    const post = vi.spyOn(apiClient, 'post');
+
+    await expect(
+      fetchPluginQuota({ name: 'flow2api-a.json', provider: 'flow2api' } as AuthFileItem, t)
+    ).rejects.toThrow('plugin_quota.missing_auth_index');
+    expect(post).not.toHaveBeenCalled();
+  });
+
+  it('formats summary metrics with their unit or currency', () => {
+    expect(
+      formatPluginQuotaMetric(
+        { key: 'credits', label: 'Flow credits', value: 24470, unit: 'credits' },
+        'en-US'
+      )
+    ).toBe('24,470 credits');
+    expect(
+      formatPluginQuotaMetric(
+        { key: 'balance', label: 'Balance', value: 12.5, format: 'currency', currency: 'USD' },
+        'en-US'
+      )
+    ).toBe('$12.50');
+  });
+});
diff --git c/apps/web/src/utils/quota/pluginQuota.ts i/apps/web/src/utils/quota/pluginQuota.ts
new file mode 100644
index 0000000..ad8e505
--- /dev/null
+++ i/apps/web/src/utils/quota/pluginQuota.ts
@@ -0,0 +1,140 @@
+import type { TFunction } from 'i18next';
+import type {
+  AntigravityQuotaBucket,
+  AntigravityQuotaGroup,
+  AntigravityQuotaSubscription,
+  AuthFileItem,
+  PluginQuotaMetric,
+} from '@/types';
+import {
+  apiClient,
+  createScopedApiRequestConfig,
+  type ApiClientRequestScope,
+} from '@/services/api/client';
+import { normalizeAuthIndex } from '@/utils/authIndex';
+import { isRecord } from '@/utils/helpers';
+import { buildAntigravityQuotaGroups } from './builders';
+import { normalizeStringValue } from './parsers';
+import { isAntigravityFile, isClaudeFile, isCodexFile, isKimiFile, isXaiFile } from './validators';
+
+export interface PluginQuotaData {
+  groups: AntigravityQuotaGroup[];
+  summary: PluginQuotaMetric[];
+  subscription: AntigravityQuotaSubscription | null;
+}
+
+const hasBuiltInQuotaAdapter = (file: AuthFileItem): boolean =>
+  isAntigravityFile(file) ||
+  isClaudeFile(file) ||
+  isCodexFile(file) ||
+  isKimiFile(file) ||
+  isXaiFile(file);
+
+// CPA lists supports_quota when a plugin quota provider answers for the
+// credential; providers with a built-in adapter keep querying upstream directly.
+export const isPluginQuotaFile = (file: AuthFileItem): boolean =>
+  file.supports_quota === true && !hasBuiltInQuotaAdapter(file);
+
+const PLUGIN_WINDOW_LABEL_KEYS: Record<string, string> = {
+  '5h': 'antigravity_quota.five_hour_limit',
+  '24h': 'antigravity_quota.daily_limit',
+  daily: 'antigravity_quota.daily_limit',
+  '7d': 'antigravity_quota.weekly_limit',
+  weekly: 'antigravity_quota.weekly_limit',
+  monthly: 'antigravity_quota.monthly_limit',
+};
+
+export const pluginQuotaBucketLabel = (bucket: AntigravityQuotaBucket, t: TFunction): string => {
+  const key = PLUGIN_WINDOW_LABEL_KEYS[(bucket.window ?? '').trim().toLowerCase()];
+  return key ? t(key) : bucket.label;
+};
+
+export const formatPluginQuotaMetric = (metric: PluginQuotaMetric, locale?: string): string => {
+  if (metric.format === 'currency' && /^[A-Za-z]{3}$/.test(metric.currency ?? '')) {
+    return new Intl.NumberFormat(locale, { style: 'currency', currency: metric.currency }).format(
+      metric.value
+    );
+  }
+  const amount = new Intl.NumberFormat(locale).format(metric.value);
+  return metric.unit ? `${amount} ${metric.unit}` : amount;
+};
+
+const parseGroups = (value: unknown): AntigravityQuotaGroup[] => {
+  const groups = (Array.isArray(value) ? value : []).filter(isRecord).map((group) => ({
+    ...group,
+    buckets: Array.isArray(group.buckets) ? group.buckets.filter(isRecord) : [],
+  }));
+  return buildAntigravityQuotaGroups({ groups }).map((group) => ({
+    ...group,
+    buckets: group.buckets.map((bucket) =>
+      bucket.window && bucket.label === bucket.id ? { ...bucket, label: bucket.window } : bucket
+    ),
+  }));
+};
+
+const parseSummary = (value: unknown): PluginQuotaMetric[] =>
+  (Array.isArray(value) ? value : []).flatMap((entry): PluginQuotaMetric[] => {
+    if (!isRecord(entry) || typeof entry.value !== 'number' || !Number.isFinite(entry.value)) {
+      return [];
+    }
+    const key = normalizeStringValue(entry.key);
+    if (!key) return [];
+    return [
+      {
+        key,
+        label: normalizeStringValue(entry.label) ?? key,
+        value: entry.value,
+        unit: normalizeStringValue(entry.unit) ?? undefined,
+        format: normalizeStringValue(entry.format) ?? undefined,
+        currency: normalizeStringValue(entry.currency) ?? undefined,
+      },
+    ];
+  });
+
+const parseSubscription = (value: unknown): AntigravityQuotaSubscription | null => {
+  if (!isRecord(value)) return null;
+  const subscription = {
+    plan: normalizeStringValue(value.plan),
+    tierName: normalizeStringValue(value.tierName ?? value.tier_name),
+    tierId: normalizeStringValue(value.tierId ?? value.tier_id),
+  };
+  return subscription.plan || subscription.tierName || subscription.tierId ? subscription : null;
+};
+
+export const parsePluginQuota = (payload: unknown): PluginQuotaData | null =>
+  isRecord(payload)
+    ? {
+        groups: parseGroups(payload.groups),
+        summary: parseSummary(payload.summary),
+        subscription: parseSubscription(payload.subscription),
+      }
+    : null;
+
+export const fetchPluginQuota = async (
+  file: AuthFileItem,
+  t: TFunction,
+  requestScope?: ApiClientRequestScope
+): Promise<PluginQuotaData> => {
+  const authIndex = normalizeAuthIndex(file['auth_index'] ?? file.authIndex);
+  if (!authIndex) {
+    throw new Error(
+      t('plugin_quota.missing_auth_index', {
+        defaultValue: 'This credential has no auth index, so its quota cannot be read.',
+      })
+    );
+  }
+  const payload = await apiClient.post(
+    '/quota/fetch',
+    { auth_index: authIndex },
+    requestScope ? createScopedApiRequestConfig(requestScope) : undefined
+  );
+  const quota = parsePluginQuota(payload);
+  if (!quota) {
+    throw new Error(
+      t('plugin_quota.invalid_response', {
+        defaultValue: 'The quota provider returned an unreadable response.',
+      })
+    );
+  }
+  return quota;
+};
