+        { menu: 'Gemini Web', description: '', path: '/v0/resource/plugins/gemini-web/index' },
+      ],
+    },
+  ],
+};
+let renderer: ReactTestRenderer;
+async function mount() {
+  await act(async () => {
+    renderer = create(<OAuthPage />);
+  });
+}
+async function click(provider: string) {
+  const button = renderer.root.findByProps({ id: `oauth-provider-${provider}` }).findByType(Button);
+  await act(async () => {
+    await button.props.onClick();
+  });
+}
+
+beforeEach(() => {
+  vi.clearAllMocks();
+  vi.stubGlobal('IS_REACT_ACT_ENVIRONMENT', true);
+  vi.stubGlobal('window', {
+    setInterval: mocks.interval,
+    clearInterval: vi.fn(),
+    clearTimeout: vi.fn(),
+  });
+  mocks.list.mockResolvedValue(plugins);
+  mocks.resource.mockResolvedValue({
+    data: '<!doctype html><title>Fixture portal</title>',
+    headers: { 'content-type': 'text/html' },
+  });
+  mocks.authFiles.mockResolvedValue({ files: [] });
+  mocks.startAuth.mockResolvedValue({
+    url: 'https://example.invalid/oauth',
+    state: 'fixture-state',
+  });
+});
+afterEach(async () => {
+  if (renderer)
+    await act(async () => {
+      renderer.unmount();
+    });
+  vi.unstubAllGlobals();
+});
+
+describe('GeminiWeb original Login button', () => {
+  it('navigates to the plugin resource before any native auth attempt when available', async () => {
+    await mount();
+    await click('gemini-web');
+    expect(mocks.navigate).toHaveBeenCalledWith('/plugin-pages/gemini-web/0');
+    expect(mocks.startAuth).not.toHaveBeenCalled();
+    expect(mocks.getAuthStatus).not.toHaveBeenCalled();
+    expect(mocks.interval).not.toHaveBeenCalled();
+    expect(mocks.authFiles).not.toHaveBeenCalled();
+  });
+
+  it.each(['missing', 'disabled', 'resource-error', 'auth-error'])(
+    'stays out of native OAuth when %s',
+    async (failure) => {
+      await mount();
+      switch (failure) {
+        case 'missing':
+          mocks.list.mockResolvedValue({ ...plugins, plugins: [] });
+          break;
+        case 'disabled':
+          mocks.list.mockResolvedValue({ ...plugins, pluginsEnabled: false });
+          break;
+        case 'resource-error':
+          mocks.resource.mockRejectedValue(new Error('unavailable'));
+          break;
+        case 'auth-error':
+          mocks.list.mockRejectedValue(Object.assign(new Error('unauthorized'), { status: 401 }));
+          break;
+      }
+      await click('gemini-web');
+      expect(mocks.navigate).not.toHaveBeenCalled();
+      expect(mocks.notify).toHaveBeenCalledWith(expect.any(String), 'error');
+      expect(mocks.startAuth).not.toHaveBeenCalled();
+      expect(mocks.getAuthStatus).not.toHaveBeenCalled();
+      expect(mocks.authFiles).not.toHaveBeenCalled();
+    }
+  );
+
+  it.each(['codex', 'anthropic', 'antigravity', 'kimi', 'xai'])(
+    'keeps %s native start and polling when its original button is clicked',
+    async (provider) => {
+      await mount();
+      await click(provider);
+      expect(mocks.startAuth).toHaveBeenCalledWith(provider, expect.any(Object));
+      expect(mocks.interval).toHaveBeenCalled();
+      expect(mocks.navigate).not.toHaveBeenCalled();
+    }
+  );
+
+  it('keeps another plugin provider on its native start path', async () => {
+    mocks.list.mockResolvedValue({
+      ...plugins,
+      plugins: plugins.plugins.map((plugin) => ({
+        ...plugin,
+        id: 'gpt-web',
+        oauthProvider: 'gpt-web',
+      })),
+    });
+    await mount();
+    await click('gpt-web');
+    expect(mocks.startAuth).toHaveBeenCalledWith('gpt-web', expect.any(Object));
+    expect(mocks.interval).toHaveBeenCalled();
+    expect(mocks.navigate).not.toHaveBeenCalled();
+  });
+});
