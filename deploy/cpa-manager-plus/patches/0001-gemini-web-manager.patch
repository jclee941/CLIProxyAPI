+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { geminiWebApi, requireGeminiWebPortal } from './geminiWeb';
+import { apiClient } from './client';
+
+const id = 'gemini-web-fixture-1.json';
+const usage = {
+  tier: null,
+  tier_code: 'opaque-42',
+  source: 'GoogleWeb',
+  estimated: false,
+  observed_at: 1800000000,
+  metrics: [
+    {
+      remaining_units: 71.25,
+      usage_fraction: null,
+      reset_unix_seconds: null,
+      window_kind: 'ai_credit',
+      unit: 'provider_compute_unit',
+      metric_type: 9,
+    },
+  ],
+};
+const account = {
+  id,
+  label: 'Fixture',
+  enabled: false,
+  status: 'ready',
+  models: [],
+  usage,
+  observed_at: 1800000001,
+};
+const base = 'http://127.0.0.1:1';
+let response: unknown;
+let status: number;
+let calls: {
+  method: string | undefined;
+  path: string | undefined;
+  body: string;
+  authorization: string | undefined;
+}[];
+beforeEach(() => {
+  response = account;
+  status = 200;
+  calls = [];
+  vi.spyOn(apiClient, 'get').mockImplementation(async (path) => {
+    calls.push({
+      method: 'GET',
+      path: `/v0/management${path}`,
+      body: '',
+      authorization: undefined,
+    });
+    return response;
+  });
+  vi.spyOn(apiClient, 'post').mockImplementation(async (path, body, config) => {
+    calls.push({
+      method: 'POST',
+      path: `/v0/management${path}`,
+      body: JSON.stringify(body),
+      authorization: String(config?.headers?.Authorization),
+    });
+    if (status !== 200) throw Object.assign(new Error('Fixture authorization failure'), { status });
+    return response;
+  });
+});
+afterEach(() => {
+  vi.restoreAllMocks();
+});
+const file = { id, name: id, type: 'gemini-web', provider: 'gemini-web' };
+const scope = () => ({ apiBase: base, managementKey: 'synthetic-manager-fixture' });
+
+describe('GeminiWeb account boundary', () => {
+  it('refreshes the exact native identity with the existing Manager transport', async () => {
+    const result = await geminiWebApi.refresh(file, scope());
+    expect(calls).toEqual([
+      {
+        method: 'POST',
+        path: '/v0/management/plugins/gemini-web/refresh',
+        body: JSON.stringify({ id }),
+        authorization: 'Bearer synthetic-manager-fixture',
+      },
+    ]);
+    expect(result).toEqual(account);
+    expect(result.usage?.metrics?.[0]).not.toHaveProperty('usage_percent');
+  });
+  it('loads the canonical account from a provider-scoped list without email fallback', async () => {
+    response = {
+      provider: 'gemini-web',
+      accounts: [{ ...account, id: 'gemini-web-other.json', label: 'Fixture' }, account],
+    };
+    expect(await geminiWebApi.load(file, scope())).toEqual(account);
+    expect(calls[0]?.path).toBe('/v0/management/plugins/gemini-web/accounts');
+  });
+  it('preserves null metrics, tier, fraction and reset rather than fabricating windows', async () => {
+    response = { ...account, usage: { ...usage, tier_code: null, metrics: null } };
+    const result = await geminiWebApi.refresh(file, scope());
+    expect(result.usage).toEqual({ ...usage, tier_code: null, metrics: null });
+  });
+  it('preserves explicit zero only when the provider actually reports it', async () => {
+    const metric = {
+      remaining_units: 0,
+      usage_fraction: 0,
+      usage_percent: 0,
+      reset_unix_seconds: 1800000500,
+      window_kind: 'unknown',
+      unit: 'provider_compute_unit',
+    };
+    response = { ...account, usage: { ...usage, metrics: [metric] } };
+    expect((await geminiWebApi.refresh(file, scope())).usage?.metrics).toEqual([metric]);
+  });
+  it.each(['error', 'expired', 'unknown'])(
+    'preserves HTTP 200 body state %s with null usage',
+    async (state) => {
+      response = { ...account, status: state, usage: null, error: 'account_check_failed' };
+      expect(await geminiWebApi.refresh(file, scope())).toEqual(response);
+    }
+  );
+  it.each([
+    { ...file, provider: 'codex' },
+    { ...file, type: 'gpt-web' },
+    { ...file, id: 'gemini-web-forged.json' },
+    { ...file, name: 'Fixture' },
+  ])('rejects cross-provider or inconsistent native identities before HTTP', async (target) => {
+    await expect(geminiWebApi.refresh(target, scope())).rejects.toThrow();
+    expect(calls).toHaveLength(0);
+  });
+  it.each([
+    { ...account, id: 'gemini-web-other.json' },
+    { ...account, usage: { ...usage, source: 'Codex' } },
+    { ...account, usage: { ...usage, estimated: true } },
+    { ...account, usage: { ...usage, metrics: [{ remaining_units: '71' }] } },
+  ])('fails closed on mismatched or malformed provider evidence', async (value) => {
+    response = value;
+    await expect(geminiWebApi.refresh(file, scope())).rejects.toThrow();
+  });
+  it.each([
+    { provider: 'codex', accounts: [account] },
+    {
+      provider: 'gemini-web',
+      accounts: [{ ...account, id: 'gemini-web-other.json', email: 'same@example.invalid' }],
+    },
+    { provider: 'gemini-web', accounts: [account, account] },
+  ])('rejects an ambiguous or non-matching list', async (value) => {
+    response = value;
+    await expect(geminiWebApi.load(file, scope())).rejects.toThrow();
+  });
+  it('does not hide transport authorization failures', async () => {
+    status = 401;
+    response = { error: 'unauthorized' };
+    await expect(geminiWebApi.refresh(file, scope())).rejects.toMatchObject({ status: 401 });
+  });
+  it('rejects missing portal resources instead of returning a blind link', async () => {
+    response = { plugins_enabled: true, plugins: [] };
+    await expect(requireGeminiWebPortal(scope())).rejects.toThrow();
+  });
+});
diff --git c/apps/web/src/services/api/geminiWeb.ts i/apps/web/src/services/api/geminiWeb.ts
