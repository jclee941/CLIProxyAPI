diff --git c/apps/web/src/features/accounts/components/accountDetail/GeminiWebQuotaPanel.tsx i/apps/web/src/features/accounts/components/accountDetail/GeminiWebQuotaPanel.tsx
new file mode 100644
index 0000000..d65975c
--- /dev/null
+++ i/apps/web/src/features/accounts/components/accountDetail/GeminiWebQuotaPanel.tsx
@@ -0,0 +1,221 @@
+import { useLayoutEffect, useMemo, useRef, useState } from 'react';
+import { useNavigate } from 'react-router-dom';
+import { useTranslation } from 'react-i18next';
+import { Button } from '@/components/ui/Button';
+import { Card } from '@/components/ui/Card';
+import { useAuthStore } from '@/stores';
+import type { AuthFileItem } from '@/types';
+import {
+  geminiWebApi,
+  geminiWebErrorMessage,
+  requireGeminiWebPortal,
+} from '@/services/api/geminiWeb';
+import {
+  GEMINI_WEB_CONFIG,
+  preserveGeminiWebObservation,
+  type GeminiWebQuotaState,
+} from '@/components/quota/geminiWebQuotaConfig';
+import styles from '@/features/accounts/AccountsPage.module.scss';
+
+const initialState: GeminiWebQuotaState = { status: 'idle', account: null, stale: false };
+
+export function GeminiWebQuotaPanel({ file }: { readonly file: AuthFileItem }) {
+  const { t, i18n } = useTranslation();
+  const navigate = useNavigate();
+  const apiBase = useAuthStore((state) => state.apiBase);
+  const managementKey = useAuthStore((state) => state.managementKey);
+  const supportsPlugin = useAuthStore((state) => state.supportsPlugin);
+  const connected = useAuthStore((state) => state.connectionStatus) === 'connected';
+  const scope = useMemo(() => ({ apiBase, managementKey }), [apiBase, managementKey]);
+  const [quota, setQuota] = useState(initialState);
+  const [pending, setPending] = useState(false);
+  const [portalError, setPortalError] = useState('');
+  const generation = useRef(0);
+  useLayoutEffect(() => {
+    setQuota(initialState);
+    setPending(false);
+    setPortalError('');
+    return () => {
+      generation.current += 1;
+    };
+  }, [scope, file.id, file.name, file.provider, file.type]);
+
+  const isCurrent = (version: number) =>
+    generation.current === version &&
+    useAuthStore.getState().apiBase === scope.apiBase &&
+    useAuthStore.getState().managementKey === scope.managementKey;
+  const load = async (refresh: boolean) => {
+    const version = generation.current;
+    setPending(true);
+    try {
+      const account = refresh
+        ? await GEMINI_WEB_CONFIG.fetchQuota(file, t, scope)
+        : await geminiWebApi.load(file, scope);
+      if (isCurrent(version))
+        setQuota((previous) =>
+          preserveGeminiWebObservation(previous, GEMINI_WEB_CONFIG.buildSuccessState(account))
+        );
+    } catch (error: unknown) {
+      if (isCurrent(version))
+        setQuota((previous) =>
+          preserveGeminiWebObservation(
+            previous,
+            GEMINI_WEB_CONFIG.buildErrorState(geminiWebErrorMessage(error))
+          )
+        );
+    } finally {
+      if (isCurrent(version)) setPending(false);
+    }
+  };
+  const openPortal = async () => {
+    const version = generation.current;
+    setPending(true);
+    setPortalError('');
+    try {
+      const route = await requireGeminiWebPortal(scope);
+      if (isCurrent(version)) navigate(route);
+    } catch (error: unknown) {
+      if (isCurrent(version)) setPortalError(geminiWebErrorMessage(error));
+    } finally {
+      if (isCurrent(version)) setPending(false);
+    }
+  };
+  const unknown = t('gemini_web.unknown', { defaultValue: 'Unknown' });
+  const time = (seconds: number | null | undefined) =>
+    seconds == null ? unknown : new Date(seconds * 1000).toLocaleString(i18n.language);
+  const account = quota.account;
+  const usage = account?.usage;
+  const fields = [
+    ['id', 'Account ID', account?.id ?? file.name],
+    ['label', 'Label', account?.label ?? unknown],
+    ['status', 'Account state (observed)', account?.status ?? unknown],
+    ['enabled', 'Enabled (observed)', account ? String(account.enabled) : unknown],
+    ['tier', 'Tier', usage?.tier ?? unknown],
+    ['tier-code', 'Tier code', usage?.tier_code ?? unknown],
+    ['account-observed', 'Account observed at', time(account?.observed_at)],
+    ['usage-observed', 'Usage observed at', time(usage?.observed_at)],
+  ];
+
+  return (
+    <section
+      className={styles.quotaSection}
+      data-gemini-web-quota={quota.status}
+      aria-busy={pending}
+    >
+      <Card title={t('gemini_web.quota_title', { defaultValue: 'GeminiWeb account quota' })}>
+        <div className={styles.quotaCardList}>
+          <p className={styles.quotaEmpty}>
+            {t('gemini_web.quota_hint', {
+              defaultValue:
+                'GoogleWeb provider measurements, not estimated request usage. Load on demand; refresh checks this account only. Login and account registration remain in the plugin panel.',
+            })}
+          </p>
+          <div className={styles.quotaTabActions}>
+            <Button
+              size="sm"
+              disabled={!connected || !supportsPlugin}
+              loading={pending}
+              onClick={() => void load(Boolean(account))}
+            >
+              {account
+                ? t('gemini_web.refresh', { defaultValue: 'Refresh GeminiWeb quota' })
+                : t('gemini_web.load', { defaultValue: 'Load GeminiWeb quota' })}
+            </Button>
+            <Button
+              size="sm"
+              variant="secondary"
+              disabled={!connected || !supportsPlugin || pending}
+              onClick={() => void openPortal()}
+            >
+              {t('gemini_web.open_panel', { defaultValue: 'Open GeminiWeb plugin panel' })}
+            </Button>
+          </div>
+          {!connected || !supportsPlugin ? (
+            <p role="alert">
+              {t('gemini_web.unsupported', {
+                defaultValue:
+                  'Connect to a Manager backend with plugin support to load GeminiWeb details.',
+              })}
+            </p>
+          ) : null}
+          {quota.error ? (
+            <div className={styles.errorBox} role="alert">
+              {quota.error}
+            </div>
+          ) : null}
+          {portalError ? (
+            <div className={styles.errorBox} role="alert">
+              {portalError}
+            </div>
+          ) : null}
+          {quota.stale ? (
+            <p role="status" data-gemini-web-stale="true">
+              {t('gemini_web.stale', {
+                defaultValue:
+                  'Refresh failed. Showing the previous observation below, not current account health or quota.',
+              })}
+            </p>
+          ) : null}
+          <dl className={styles.overviewFieldGrid}>
+            {fields.map(([key, label, value]) => (
+              <div key={key} data-gemini-web-field={key}>
+                <dt>{t(`gemini_web.${key}`, { defaultValue: String(label) })}</dt>
+                <dd>{value}</dd>
+              </div>
+            ))}
+          </dl>
+          <dl className={styles.overviewFieldGrid}>
+            <div>
+              <dt>{t('gemini_web.models', { defaultValue: 'Models (observed)' })}</dt>
+              <dd>
+                {account?.models.length
+                  ? account.models.map((model) => `${model.name} (${model.id})`).join(', ')
+                  : unknown}
+              </dd>
+            </div>
+          </dl>
+          {(usage?.metrics ?? []).map((metric, index) => (
+            <dl className={styles.overviewFieldGrid} key={index} data-gemini-web-metric={index}>
+              <div>
+                <dt>{t('gemini_web.window', { defaultValue: 'Provider window' })}</dt>
+                <dd>{metric.window_kind}</dd>
+              </div>
+              <div>
+                <dt>
+                  {t('gemini_web.remaining', { defaultValue: 'Remaining provider compute units' })}
+                </dt>
+                <dd>{metric.remaining_units ?? unknown}</dd>
+              </div>
+              <div>
+                <dt>{t('gemini_web.fraction', { defaultValue: 'Reported usage fraction' })}</dt>
+                <dd>{metric.usage_fraction ?? unknown}</dd>
+              </div>
+              <div>
+                <dt>{t('gemini_web.percent', { defaultValue: 'Reported usage percent' })}</dt>
+                <dd>{metric.usage_percent === undefined ? unknown : `${metric.usage_percent}%`}</dd>
+              </div>
+              <div>
+                <dt>{t('gemini_web.reset', { defaultValue: 'Reset at' })}</dt>
+                <dd>{time(metric.reset_unix_seconds)}</dd>
+              </div>
+              {metric.metric_type !== undefined ? (
+                <div>
+                  <dt>{t('gemini_web.metric_type', { defaultValue: 'Metric type' })}</dt>
+                  <dd>{metric.metric_type}</dd>
+                </div>
+              ) : null}
+            </dl>
+          ))}
+          {!usage?.metrics?.length ? (
+            <p className={styles.quotaEmpty}>
+              {t('gemini_web.no_metrics', {
+                defaultValue:
+                  'No provider quota metrics observed. This does not mean zero or unlimited quota.',
+              })}
+            </p>
+          ) : null}
+        </div>
+      </Card>
+    </section>
+  );
+}
