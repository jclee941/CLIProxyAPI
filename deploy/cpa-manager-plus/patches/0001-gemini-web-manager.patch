+vi.mock('@/services/api', () => ({
+  oauthApi: { startAuth: mocks.startAuth, getAuthStatus: mocks.getAuthStatus },
+  authFilesApi: { list: mocks.authFiles },
+  pluginsApi: { list: mocks.list },
+}));
+vi.mock('@/services/api/plugins', () => ({ pluginsApi: { list: mocks.list } }));
+vi.mock('@/services/api/client', () => ({
+  apiClient: { getRaw: mocks.resource },
+  createScopedApiRequestConfig: () => ({}),
+}));
+vi.mock('@/features/monitoring/codexInspection', () => ({
+  createCodexInspectionConnectionFingerprint: (apiBase: string) => apiBase,
+}));
+
+const plugins: PluginListResponse = {
+  pluginsEnabled: true,
+  pluginsDir: 'plugins',
+  plugins: [
+    {
+      id: 'gemini-web',
+      oauthProvider: 'gemini-web',
+      path: '',
+      configured: true,
+      registered: true,
+      enabled: true,
+      effectiveEnabled: true,
+      supportsOAuth: true,
+      logo: '',
+      configFields: [],
