+import { apiClient, createScopedApiRequestConfig } from '@/services/api/client';
+import { useAuthStore } from '@/stores/useAuthStore';
+import { isRecord } from '@/utils/helpers';
+import { allowChatGPTPost, chatgptErrorCodes } from './chatgptHostPolicy';
+
+type PluginRequest = {
+  readonly path: string;
+  readonly method: 'GET' | 'POST';
+  readonly body?: string;
+};
+type PluginResponse = { readonly status: number; readonly body: string };
+const supportedPlugin = (id: string) => id === 'gemini-web' || id === 'chatgpt2api';
+const accountPattern = /^gemini-web-[A-Za-z0-9_-]+\.json$/;
+const safePath = (path: string) => /^\/[A-Za-z0-9_/-]+$/.test(path) && !path.includes('//');
+const failure = (status: number): PluginResponse => ({
+  status,
+  body: '{"error":"host_request_failed"}',
+});
+const pluginErrorCodes = new Set([
+  'account_unavailable',
+  'sidecar_request_failed',
+  'disabled_account_update_requires_host_enable',
+  'secret_store_unavailable',
+]);
+
+export function safePluginError(body: string, pluginID = 'gemini-web'): string | undefined {
+  try {
+    const payload: unknown = JSON.parse(body);
+    return isRecord(payload) &&
+      typeof payload.error === 'string' &&
+      (pluginID === 'chatgpt2api' ? chatgptErrorCodes : pluginErrorCodes).has(payload.error)
+      ? payload.error
+      : undefined;
+  } catch {
+    return undefined;
+  }
+}
+type RequestAuth = Pick<
+  ReturnType<typeof useAuthStore.getState>,
+  'apiBase' | 'managementKey' | 'isAuthenticated' | 'connectionStatus' | 'supportsPlugin'
+>;
+
+export function isPluginRequestAuthCurrent(original: RequestAuth, current: RequestAuth): boolean {
+  return (
+    current.isAuthenticated &&
+    current.connectionStatus === 'connected' &&
+    current.supportsPlugin &&
+    current.apiBase === original.apiBase &&
+    current.managementKey === original.managementKey &&
+    Boolean(current.managementKey)
+  );
+}
+
+export function trustedPluginResource(pluginID: string, url: string, origin: string): boolean {
+  try {
+    const resource = new URL(url);
+    return (
+      supportedPlugin(pluginID) &&
+      resource.origin === origin &&
+      !resource.username &&
+      !resource.password &&
+      !resource.search &&
+      !resource.hash &&
+      url === resource.href &&
+      safePath(resource.pathname) &&
+      resource.pathname.startsWith(`/v0/resource/plugins/${pluginID}/`)
+    );
+  } catch {
+    return false;
+  }
+}
+
+export function allowPluginRequest(
+  pluginID: string,
+  input: unknown,
+  accounts: ReadonlySet<string>
+): input is PluginRequest {
+  if (
+    !supportedPlugin(pluginID) ||
+    !isRecord(input) ||
+    typeof input.path !== 'string' ||
+    typeof input.method !== 'string' ||
+    !['GET', 'POST'].includes(input.method) ||
+    Object.keys(input).some((key) => !['path', 'method', 'body'].includes(key)) ||
+    (input.body !== undefined && (typeof input.body !== 'string' || input.method !== 'POST'))
+  )
+    return false;
+  if (pluginID === 'chatgpt2api' && input.method === 'POST')
+    return allowChatGPTPost(input.path, input.body);
+  if (safePath(input.path) && input.path.startsWith(`/v0/management/plugins/${pluginID}/`))
+    return true;
+  const name =
+    /^\/v0\/management\/auth-files\/models\?name=(gemini-web-[A-Za-z0-9_-]+\.json)$/.exec(
+      input.path
+    )?.[1];
+  return pluginID === 'gemini-web' && input.method === 'GET' && Boolean(name && accounts.has(name));
+}
+
+export function createPluginHostRequestBridge(
+  iframe: HTMLIFrameElement,
+  resource: { readonly pluginID: string; readonly url: string }
+): (() => void) | undefined {
+  const auth = useAuthStore.getState();
+  const origin = window.location.origin;
+  if (auth.apiBase !== origin || !trustedPluginResource(resource.pluginID, resource.url, origin))
+    return;
+  const child = iframe.contentWindow;
+  const document = iframe.contentDocument;
+  if (
+    !child ||
+    !document ||
+    document.readyState !== 'complete' ||
+    !child.navigation ||
+    !window.navigation
+  )
+    return;
+  const childNavigation = child.navigation;
+  const parentNavigation = window.navigation;
+  const pending = new Set<AbortController>();
+  const accounts = new Set<string>();
+  let active = true;
+  const current = () => {
+    try {
+      const state = useAuthStore.getState();
+      return (
+        active &&
+        isPluginRequestAuthCurrent(auth, state) &&
+        iframe.isConnected &&
+        iframe.ownerDocument === window.document &&
+        !iframe.hasAttribute('srcdoc') &&
+        iframe.contentDocument === document &&
+        child.document === document &&
+        child.location.href === resource.url &&
+        iframe.src === resource.url
+      );
+    } catch {
+      return false;
+    }
+  };
+  const observer = new MutationObserver(() => {
+    if (!current()) revoke();
+  });
+  const revoke = () => {
+    if (!active) return;
+    active = false;
+    for (const controller of pending) controller.abort();
+    pending.clear();
+    accounts.clear();
+    unsubscribe();
+    observer.disconnect();
+    childNavigation.removeEventListener('navigate', revoke);
+    parentNavigation.removeEventListener('navigate', revoke);
+    child.removeEventListener('pagehide', revoke);
+    child.removeEventListener('hashchange', revoke);
+    child.removeEventListener('popstate', revoke);
+    window.removeEventListener('pagehide', revoke);
+    window.removeEventListener('hashchange', revoke);
+  };
+  if (!current()) return;
+  const request = async (input: unknown): Promise<PluginResponse> => {
+    const controller = new AbortController();
+    try {
+      if (!current()) {
+        revoke();
+        return failure(401);
+      }
+      if (!allowPluginRequest(resource.pluginID, input, accounts)) return failure(403);
+      const state = useAuthStore.getState();
+      pending.add(controller);
+      const response = await apiClient.requestRaw({
+        ...createScopedApiRequestConfig({
+          apiBase: state.apiBase,
+          managementKey: state.managementKey,
+        }),
+        url: input.path.slice('/v0/management'.length),
+        method: input.method,
+        data: input.body,
+        signal: controller.signal,
+        timeout: 0,
+        adapter: 'fetch',
+        responseType: 'text',
+        fetchOptions: {
+          redirect: 'error',
+          mode: 'same-origin',
+          cache: 'no-store',
+          referrerPolicy: 'no-referrer',
+        },
+        transformResponse: [(data: unknown) => data],
+        validateStatus: () => true,
+      });
+      if (!current() || controller.signal.aborted) {
+        revoke();
+        return failure(401);
+      }
+      const body: unknown = response.data;
+      if (typeof body !== 'string') return failure(502);
+      const chatgptPayload: unknown = resource.pluginID === 'chatgpt2api' ? JSON.parse(body) : undefined;
+      if (response.status < 200 || response.status >= 300 || (isRecord(chatgptPayload) && 'error' in chatgptPayload)) {
+        const code =
+          input.path.startsWith(`/v0/management/plugins/${resource.pluginID}/`)
+            ? safePluginError(body, resource.pluginID)
+            : undefined;
+        const googleAuthFailure =
+          code === 'account_unavailable' || code === 'sidecar_request_failed';
+        const chatgptAccountFailure = resource.pluginID === 'chatgpt2api' && code !== undefined;
+        if (response.status === 401 && !googleAuthFailure && !chatgptAccountFailure)
+          window.dispatchEvent(new Event('unauthorized'));
+        return code
+          ? { status: response.status, body: JSON.stringify({ error: code }) }
+          : failure(response.status);
+      }
+      if (body.includes(state.managementKey)) return failure(502);
+      if (resource.pluginID === 'gemini-web') {
+        const payload: unknown = JSON.parse(body);
+        if (
+          input.path === '/v0/management/plugins/gemini-web/accounts' &&
+          input.method === 'GET' &&
+          isRecord(payload) &&
+          payload.provider === 'gemini-web' &&
+          Array.isArray(payload.accounts)
+        ) {
+          accounts.clear();
+          for (const account of payload.accounts) {
+            if (
+              isRecord(account) &&
+              typeof account.id === 'string' &&
+              accountPattern.test(account.id)
+            )
+              accounts.add(account.id);
+          }
+        }
+        if (
+          input.path === '/v0/management/plugins/gemini-web/refresh' &&
+          input.method === 'POST' &&
+          isRecord(payload) &&
+          typeof payload.id === 'string' &&
+          accountPattern.test(payload.id)
+        )
+          accounts.add(payload.id);
+      }
+      return { status: response.status, body };
+    } catch (error) {
+      const status =
+        isRecord(error) &&
+        typeof error.status === 'number' &&
+        error.status >= 400 &&
+        error.status <= 599
+          ? error.status
+          : 502;
+      return failure(current() ? status : 401);
+    } finally {
+      pending.delete(controller);
+    }
+  };
+  const capability = Object.freeze({
+    version: 1,
+    pluginID: resource.pluginID,
+    resourceURL: resource.url,
+    request: Object.freeze(request),
+  });
+  Object.defineProperty(child, '__CPAMP_PLUGIN_HOST__', { value: capability, configurable: true });
+  childNavigation.addEventListener('navigate', revoke);
+  parentNavigation.addEventListener('navigate', revoke);
+  child.addEventListener('pagehide', revoke);
+  child.addEventListener('hashchange', revoke);
+  child.addEventListener('popstate', revoke);
+  window.addEventListener('pagehide', revoke);
+  window.addEventListener('hashchange', revoke);
+  observer.observe(iframe, { attributes: true, attributeFilter: ['src', 'srcdoc'] });
+  observer.observe(window.document.body, { childList: true, subtree: true });
+  const unsubscribe = useAuthStore.subscribe(() => {
+    if (!current()) revoke();
+  });
+  child.dispatchEvent(new Event('cpamp-plugin-request-ready'));
+  return revoke;
+}
