diff --git a/sdk/cliproxy/auth/conductor_stop_boundary_test.go b/sdk/cliproxy/auth/conductor_stop_boundary_test.go
new file mode 100644
--- /dev/null
+++ b/sdk/cliproxy/auth/conductor_stop_boundary_test.go
@@ -0,0 +1,44 @@
+package auth
+
+import (
+	"errors"
+	"net/http"
+	"testing"
+)
+
+type stopBoundaryFixtureError struct {
+	headers http.Header
+}
+
+func (err *stopBoundaryFixtureError) Error() string {
+	return `{"error":{"code":"incomplete_upstream_response","type":"server_error","message":"synthetic"}}`
+}
+func (err *stopBoundaryFixtureError) StatusCode() int      { return http.StatusBadGateway }
+func (err *stopBoundaryFixtureError) Headers() http.Header { return err.headers }
+
+func TestStopBoundaryPreservesTerminalMarker(t *testing.T) {
+	cause := &stopBoundaryFixtureError{headers: http.Header{"Retry-After": {"9"}, "X-Should-Retry": {"true"}}}
+	wrapped := wrapRequestStopError(markUpstreamExecutionAttempt(cause))
+	boundary := unwrapExecutionBoundaryError(wrapped)
+	if !isRequestStopError(boundary) || !errors.Is(boundary, cause) {
+		t.Fatalf("boundary lost stop or cause: %T", boundary)
+	}
+	if statusCodeFromError(boundary) != http.StatusBadGateway {
+		t.Fatal("boundary changed HTTP status")
+	}
+	headers, ok := boundary.(interface{ Headers() http.Header })
+	if !ok || headers.Headers().Get("X-Should-Retry") != "false" || headers.Headers().Get("Retry-After") != "9" {
+		t.Fatal("boundary lost safe stop or original headers")
+	}
+	headers.Headers().Set("Retry-After", "1")
+	if cause.headers.Get("Retry-After") != "9" || cause.headers.Get("X-Should-Retry") != "true" {
+		t.Fatal("boundary mutated original headers")
+	}
+}
+
+func TestStopBoundaryLeavesOrdinaryErrorUnwrapped(t *testing.T) {
+	cause := &stopBoundaryFixtureError{}
+	if got := unwrapExecutionBoundaryError(markUpstreamExecutionAttempt(cause)); got != cause {
+		t.Fatalf("ordinary error changed: %T", got)
+	}
+}
