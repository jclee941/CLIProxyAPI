+++ b/sdk/api/handlers/handlers_stop_test.go
@@ -0,0 +1,48 @@
+package handlers
+
+import (
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+)
+
+type stopHeaderFixtureError struct{ stopped bool }
+
+func (err stopHeaderFixtureError) Error() string {
+	return `{"error":{"code":"incomplete_upstream_response","type":"server_error","message":"synthetic"}}`
+}
+func (err stopHeaderFixtureError) StatusCode() int     { return http.StatusBadGateway }
+func (err stopHeaderFixtureError) IsRequestStop() bool { return err.stopped }
+func (err stopHeaderFixtureError) Headers() http.Header {
+	return http.Header{"X-Should-Retry": {"true"}}
+}
+
+func TestStopHeaderOverridesPassthrough(t *testing.T) {
+	for _, passthrough := range []bool{false, true} {
+		for _, stopped := range []bool{false, true} {
+			t.Run(fmt.Sprintf("passthrough=%t/stop=%t", passthrough, stopped), func(t *testing.T) {
+				recorder := httptest.NewRecorder()
+				ctx, _ := gin.CreateTestContext(recorder)
+				handler := &BaseAPIHandler{Cfg: &config.SDKConfig{PassthroughHeaders: passthrough}}
+				handler.WriteErrorResponse(ctx, executionErrorMessage(stopHeaderFixtureError{stopped: stopped}))
+				want := ""
+				if passthrough {
+					want = "true"
+				}
+				if stopped {
+					want = "false"
+				}
+				if got := recorder.Header().Get("X-Should-Retry"); got != want {
+					t.Fatalf("retry header = %q, want %q", got, want)
+				}
+				if recorder.Code != http.StatusBadGateway {
+					t.Fatalf("status = %d", recorder.Code)
+				}
+			})
+		}
+	}
+}
