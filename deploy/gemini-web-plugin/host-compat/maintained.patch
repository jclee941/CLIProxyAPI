+func TestHostAuthSavePreservesDisabled(t *testing.T) {
+	for _, persistent := range []bool{false, true} {
+		mode := "runtime-only"
+		if persistent {
+			mode = "file-token-store"
+		}
+		t.Run(mode, func(t *testing.T) {
+			for _, test := range []struct {
+				name             string
+				incoming         string
+				existing         bool
+				existingDisabled bool
+				wantDisabled     bool
+			}{
+				{name: "new disabled", incoming: `,"disabled":true`, wantDisabled: true},
+				{name: "active becomes disabled", incoming: `,"disabled":true`, existing: true, wantDisabled: true},
+				{name: "disabled stays disabled", incoming: `,"disabled":true`, existing: true, existingDisabled: true, wantDisabled: true},
+				{name: "false cannot enable", incoming: `,"disabled":false`, existing: true, existingDisabled: true, wantDisabled: true},
+				{name: "omission cannot enable", existing: true, existingDisabled: true, wantDisabled: true},
+				{name: "new active", incoming: `,"disabled":false`},
+				{name: "default active"},
+				{name: "active stays active", existing: true, incoming: `,"disabled":false`},
+				{name: "case sensitive field", incoming: `,"Disabled":true`},
+			} {
+				t.Run(test.name, func(t *testing.T) {
+					authDir := t.TempDir()
+					host := New()
+					host.runtimeConfig = &config.Config{AuthDir: authDir}
+					var store coreauth.Store
+					if persistent {
+						fileStore := tokenauth.NewFileTokenStore()
+						fileStore.SetBaseDir(authDir)
+						store = fileStore
+					}
+					manager := coreauth.NewManager(store, nil, nil)
+					host.SetAuthManager(manager)
+					const name = "saved.json"
+					if test.existing {
+						status := coreauth.StatusActive
+						if test.existingDisabled {
+							status = coreauth.StatusDisabled
+						}
+						_, errRegister := manager.Register(t.Context(), &coreauth.Auth{
+							ID: name, FileName: name, Provider: "demo",
+							Disabled: test.existingDisabled, Status: status,
+						})
+						if errRegister != nil {
+							t.Fatalf("register auth: %v", errRegister)
+						}
+					}
+					accountNumber := "42"
+					if test.wantDisabled {
+						accountNumber = "9007199254740993"
+					}
+					metadata := `"type":"demo","account_number":` + accountNumber + `,"nested":{"items":[1,"x",null]},"note":"unchanged"`
+					request := []byte(`{"name":"  saved.json  ","json":{` + metadata + test.incoming + `}}`)
+
+					rawResponse, errCall := host.callFromPlugin(t.Context(), pluginabi.MethodHostAuthSave, request)
+
+					if errCall != nil {
+						t.Fatalf("host.auth.save: %v", errCall)
+					}
+					response, errDecode := decodeRPCEnvelope[pluginapi.HostAuthSaveResponse](rawResponse)
+					if errDecode != nil {
+						t.Fatalf("decode response: %v", errDecode)
+					}
+					if response.Name != name || response.Path != filepath.Join(authDir, name) {
+						t.Fatalf("response has noncanonical name/path: %#v", response)
+					}
+					auth, ok := manager.GetByID(name)
+					if !ok || auth.FileName != name || len(manager.List()) != 1 {
+						t.Fatal("save did not retain a single canonical ID/FileName")
+					}
+					wantStatus := coreauth.StatusActive
+					if test.wantDisabled {
+						wantStatus = coreauth.StatusDisabled
+					}
+					if auth.Disabled != test.wantDisabled || auth.Status != wantStatus {
+						t.Errorf("runtime disabled/status = %v/%s, want %v/%s", auth.Disabled, auth.Status, test.wantDisabled, wantStatus)
+					}
+					if test.wantDisabled && auth.Metadata["disabled"] != true {
+						t.Errorf("runtime metadata disabled = %v, want true", auth.Metadata["disabled"])
+					}
+					data, errRead := os.ReadFile(response.Path)
+					if errRead != nil {
+						t.Fatalf("read saved file: %v", errRead)
+					}
+					var fields map[string]json.RawMessage
+					if errDecode := json.Unmarshal(data, &fields); errDecode != nil {
+						t.Fatalf("decode saved fields: %v", errDecode)
+					}
+					persistedDisabled := false
+					if rawDisabled, exists := fields["disabled"]; exists {
+						if errDecode := json.Unmarshal(rawDisabled, &persistedDisabled); errDecode != nil {
+							t.Fatalf("decode saved disabled: %v", errDecode)
+						}
+					}
+					if persistedDisabled != test.wantDisabled {
+						t.Errorf("persisted disabled = %v, want %v", persistedDisabled, test.wantDisabled)
+					}
+					for key, want := range map[string]string{
+						"account_number": accountNumber, "nested": `{"items":[1,"x",null]}`, "note": `"unchanged"`,
+					} {
+						if string(fields[key]) != want {
+							t.Errorf("unrelated %s changed: %s", key, fields[key])
+						}
+					}
+				})
+			}
+		})
+	}
+}
+
+func TestHostAuthSaveRejectsInvalidDisabledBeforeWrite(t *testing.T) {
+	for _, invalid := range []string{`"true"`, `"false"`, `1`, `null`, `[]`, `{}`} {
+		t.Run(invalid, func(t *testing.T) {
+			authDir := t.TempDir()
+			path := filepath.Join(authDir, "saved.json")
+			const original = `{"type":"demo","disabled":true,"note":"original"}`
+			if errWrite := os.WriteFile(path, []byte(original), 0o600); errWrite != nil {
+				t.Fatalf("write original: %v", errWrite)
+			}
+			host := New()
+			host.runtimeConfig = &config.Config{AuthDir: authDir}
+			store := tokenauth.NewFileTokenStore()
+			store.SetBaseDir(authDir)
+			manager := coreauth.NewManager(store, nil, nil)
+			host.SetAuthManager(manager)
+			if _, errRegister := manager.Register(t.Context(), &coreauth.Auth{
+				ID: "saved.json", FileName: "saved.json", Provider: "demo", Disabled: true, Status: coreauth.StatusDisabled,
+			}); errRegister != nil {
+				t.Fatalf("register auth: %v", errRegister)
+			}
+			request := []byte(`{"name":"saved.json","json":{"type":"demo","disabled":` + invalid + `}}`)
+
+			_, errCall := host.callFromPlugin(t.Context(), pluginabi.MethodHostAuthSave, request)
+
+			if errCall == nil {
+				t.Error("host.auth.save accepted invalid disabled metadata")
+			}
+			data, errRead := os.ReadFile(path)
+			if errRead != nil {
+				t.Fatalf("read original: %v", errRead)
+			}
+			if string(data) != original {
+				t.Errorf("source changed after validation failure: %s", data)
+			}
+			auth, ok := manager.GetByID("saved.json")
+			if !ok || !auth.Disabled || auth.Status != coreauth.StatusDisabled {
+				t.Error("runtime disabled state changed after validation failure")
+			}
+		})
+	}
+}
+
+func TestHostAuthUpsertPreservesDisableAfterBuild(t *testing.T) {
+	authDir := t.TempDir()
+	path := filepath.Join(authDir, "saved.json")
+	const original = `{"type":"demo","disabled":false,"note":"retained"}`
+	if errWrite := os.WriteFile(path, []byte(original), 0o600); errWrite != nil {
+		t.Fatalf("write auth: %v", errWrite)
+	}
+	store := tokenauth.NewFileTokenStore()
+	store.SetBaseDir(authDir)
+	manager := coreauth.NewManager(store, nil, nil)
+	host := New()
+	host.runtimeConfig = &config.Config{AuthDir: authDir}
+	host.SetAuthManager(manager)
+	prepared, errBuild := host.buildAuthFromFileData(path, []byte(original))
+	if errBuild != nil {
+		t.Fatalf("build auth: %v", errBuild)
+	}
+	if _, errRegister := manager.Register(t.Context(), &coreauth.Auth{
+		ID: "saved.json", FileName: "saved.json", Provider: "demo",
+		Disabled: true, Status: coreauth.StatusDisabled,
+	}); errRegister != nil {
+		t.Fatalf("register disabled runtime: %v", errRegister)
+	}
+
+	errUpsert := host.upsertAuthRecord(t.Context(), prepared)
+
+	if errUpsert != nil {
+		t.Fatalf("upsert auth: %v", errUpsert)
+	}
+	auth, ok := manager.GetByID("saved.json")
+	if !ok || !auth.Disabled || auth.Status != coreauth.StatusDisabled || auth.Metadata["disabled"] != true {
+		t.Error("upsert lost disabled runtime state observed after build")
+	}
+	data, errRead := os.ReadFile(path)
+	if errRead != nil {
+		t.Fatalf("read auth: %v", errRead)
+	}
+	var fields struct {
+		Disabled bool   `json:"disabled"`
+		Note     string `json:"note"`
+	}
+	if errDecode := json.Unmarshal(data, &fields); errDecode != nil {
+		t.Fatalf("decode auth: %v", errDecode)
+	}
+	if !fields.Disabled || fields.Note != "retained" {
+		t.Errorf("upsert persisted wrong state: %#v", fields)
+	}
+}
