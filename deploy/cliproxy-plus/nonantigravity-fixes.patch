index 000000000..3e097599d
--- /dev/null
+++ 2/internal/runtime/executor/claude_executor_legacy_override_test.go
@@ -0,0 +1,47 @@
+package executor
+
+import (
+	"net/http"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+)
+
+func TestApplyClaudeHeaders_LegacyOverridePreservesClientPlatformWhenIdentityUnchanged(t *testing.T) {
+	const clientUserAgent = "claude-cli/2.1.62 (external, cli)"
+	for _, testCase := range []struct {
+		name     string
+		override string
+	}{
+		{name: "same literal", override: clientUserAgent},
+		{name: "dynamic passthrough", override: "$User-Agent"},
+		{name: "missing dynamic header", override: "$Missing-User-Agent"},
+	} {
+		t.Run(testCase.name, func(t *testing.T) {
+			stabilize := false
+			cfg := &config.Config{ClaudeHeaderDefaults: config.ClaudeHeaderDefaults{
+				UserAgent:              "claude-cli/2.1.60 (external, cli)",
+				PackageVersion:         "0.70.0",
+				RuntimeVersion:         "v22.0.0",
+				StabilizeDeviceProfile: &stabilize,
+			}}
+			auth := &cliproxyauth.Auth{ID: testCase.name, Attributes: map[string]string{
+				"api_key":           "test-legacy-override",
+				"header:user-agent": testCase.override,
+			}}
+			request := newClaudeHeaderTestRequest(t, http.Header{
+				"User-Agent":       {clientUserAgent},
+				"X-Stainless-Os":   {"Linux"},
+				"X-Stainless-Arch": {"x64"},
+			})
+
+			errHeaders := applyClaudeHeaders(request, auth, "test-legacy-override", false, nil, nil, cfg, nil, true)
+
+			if errHeaders != nil {
+				t.Fatal(errHeaders)
+			}
+			assertClaudeFingerprint(t, request.Header, clientUserAgent, "0.70.0", "v22.0.0", "Linux", "x64")
+		})
+	}
+}
