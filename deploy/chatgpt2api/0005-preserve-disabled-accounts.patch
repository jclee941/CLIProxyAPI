new file mode 100644
index 0000000..143f692
--- /dev/null
+++ b/test/manual_disabled_http.py
@@ -0,0 +1,72 @@
+from __future__ import annotations
+
+import json
+import socket
+from threading import Thread
+import time
+from urllib.error import HTTPError
+from urllib.request import Request, urlopen
+from unittest import mock
+
+from curl_cffi import requests
+import uvicorn
+
+from test.test_preserve_disabled_accounts import PreserveDisabledTests, DISABLED, TOKEN
+
+
+def main() -> None:
+    case = PreserveDisabledTests()
+    case.setUp()
+    with socket.socket() as listener, mock.patch.object(requests.Session, "request", side_effect=AssertionError("external HTTP forbidden")):
+        listener.bind(("127.0.0.1", 0))
+        server = uvicorn.Server(uvicorn.Config(case.client.app, log_level="error"))
+        thread = Thread(target=server.run, kwargs={"sockets": [listener]})
+        thread.start()
+        origin = "http://127.0.0.1:" + str(listener.getsockname()[1])
+
+        def call(method: str, path: str, payload: str | None = None):
+            request = Request(origin + path, method=method, data=payload.encode() if payload else None,
+                              headers={"Authorization": "Bearer offline-test-only", "Content-Type": "application/json"})
+            with urlopen(request) as response:
+                return json.load(response)
+
+        try:
+            deadline = time.monotonic() + 5
+            while not server.started:
+                assert time.monotonic() < deadline
+                time.sleep(0.01)
+            inventory = call("GET", "/api/accounts")
+            assert inventory["capabilities"] == {"preserve_disabled_accounts": 1}
+            body = json.dumps({"preserve_disabled": True, "accounts": [{"access_token": TOKEN, "status": DISABLED, "source_type": "codex"}]})
+            imported = call("POST", "/api/accounts", body)
+            assert imported["added"] == 1 and imported["items"][0]["status"] == DISABLED
+            before = case.storage.file_path.read_bytes()
+            duplicate = call("POST", "/api/accounts", body)
+            assert duplicate["added"] == 0 and duplicate["refreshed"] == 0
+            assert case.storage.file_path.read_bytes() == before
+            started = call("POST", "/api/accounts/refresh", json.dumps({"access_tokens": [TOKEN], "preserve_disabled": True}))
+            deadline = time.monotonic() + 5
+            while True:
+                progress = call("GET", "/api/accounts/refresh/progress/" + started["progress_id"])
+                if progress["done"]:
+                    break
+                assert time.monotonic() < deadline
+                time.sleep(0.01)
+            assert progress["result"]["items"][0]["status"] == DISABLED
+            assert set(case.saved_statuses) == {DISABLED}
+            try:
+                call("POST", "/api/accounts", json.dumps({"preserve_disabled": True, "tokens": [TOKEN]}))
+            except HTTPError as error:
+                assert error.code == 400
+            else:
+                raise AssertionError("bad import was accepted")
+            print(json.dumps({"surface": "live loopback HTTP", "new_disabled_import": "PASS", "duplicate_no_write": "PASS", "disabled_quota_refresh": "PASS", "bad_input_400": "PASS", "all_persisted_states_disabled": True, "writes": len(case.saved_statuses)}))
+        finally:
+            server.should_exit = True
+            thread.join(5)
+            assert not thread.is_alive()
+            case.doCleanups()
+
+
+if __name__ == "__main__":
+    main()
diff --git a/test/run_preserve_disabled_offline.py b/test/run_preserve_disabled_offline.py
new file mode 100644
index 0000000..4d0c5b0
--- /dev/null
+++ b/test/run_preserve_disabled_offline.py
@@ -0,0 +1,52 @@
+from __future__ import annotations
+
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+
+
+def main() -> int:
+    root = Path(__file__).resolve().parents[1]
+    with tempfile.TemporaryDirectory(prefix="disabled-offline-") as directory:
+        sandbox = Path(directory)
+        for name in ("api", "services", "utils", "test"):
+            for source in (root / name).rglob("*.py"):
+                target = sandbox / source.relative_to(root)
+                target.parent.mkdir(parents=True, exist_ok=True)
+                shutil.copyfile(source, target)
+        command = """
+import socket
+import sys
+import unittest
+from unittest import mock
+from curl_cffi import requests
+if sys.argv[1:] == ['--manual']:
+    from test.manual_disabled_http import main
+    main()
+    raise SystemExit(0)
+with (
+    mock.patch.object(socket.socket, 'connect', side_effect=AssertionError('offline network forbidden')),
+    mock.patch.object(requests.Session, 'request', side_effect=AssertionError('offline HTTP forbidden')),
+):
+    suite = unittest.defaultTestLoader.loadTestsFromNames([
+        'test.test_preserve_disabled_accounts',
+        'test.test_account_export',
+        'test.test_account_image_capabilities',
+    ])
+    result = unittest.TextTestRunner(verbosity=2).run(suite)
+    raise SystemExit(not result.wasSuccessful())
+"""
+        result = subprocess.run(
+            [sys.executable, "-B", "-c", command, *sys.argv[1:]], cwd=sandbox,
+            env={"PATH": os.defpath, "STORAGE_BACKEND": "json", "PYTHONDONTWRITEBYTECODE": "1",
+                 "CHATGPT2API_AUTH_KEY": "offline-test-only"},
+            check=False,
+        )
+        return result.returncode
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/test/test_preserve_disabled_accounts.py b/test/test_preserve_disabled_accounts.py
new file mode 100644
index 0000000..9137b31
--- /dev/null
+++ b/test/test_preserve_disabled_accounts.py
@@ -0,0 +1,267 @@
+from __future__ import annotations
+
+from pathlib import Path
+import tempfile
+from threading import Event
+import unittest
+from unittest import mock
+
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+from api import accounts
+from services import openai_backend_api
+from services.account_service import AccountService
+from services.config import config
+from services.storage.json_storage import JSONStorageBackend
+
+
+TOKEN = "synthetic-disabled-access"
+DISABLED = "\u7981\u7528"
+NORMAL = "\u6b63\u5e38"
+LIMITED = "\u9650\u6d41"
+
+
+class PreserveDisabledTests(unittest.TestCase):
+    def __init__(self, methodName: str = "runTest") -> None:
+        super().__init__(methodName)
+        directory = self.enterContext(tempfile.TemporaryDirectory())
+        self.storage = JSONStorageBackend(Path(directory) / "accounts.json")
+        self.service = AccountService(self.storage)
+        self.me: mock.Mock = mock.Mock()
+        self.init: mock.Mock = mock.Mock()
+        self.saved_statuses: list[str] = []
+        app = FastAPI()
+        app.include_router(accounts.create_router())
+        self.client = TestClient(app)
+
+    def setUp(self) -> None:
+        self.enterContext(mock.patch.object(self.service, "_get_cumulative_file", return_value=self.storage.file_path.with_name("total")))
+        self.enterContext(mock.patch.object(accounts, "account_service", self.service))
+        self.enterContext(mock.patch.object(openai_backend_api, "account_service", self.service))
+        self.enterContext(mock.patch.object(type(config), "auto_remove_rate_limited_accounts", new_callable=mock.PropertyMock, return_value=True))
+        self.enterContext(mock.patch.object(type(config), "auto_relogin_after_refresh", new_callable=mock.PropertyMock, return_value=False))
+        self.me = self.enterContext(mock.patch.object(openai_backend_api.OpenAIBackendAPI, "_get_me", return_value={"email": "synthetic@example.invalid", "id": "synthetic-user"}))
+        self.init = self.enterContext(mock.patch.object(openai_backend_api.OpenAIBackendAPI, "_get_conversation_init", return_value={"limits_progress": [{"feature_name": "image_gen", "remaining": 8}]}))
+        self.enterContext(mock.patch.object(openai_backend_api.OpenAIBackendAPI, "_get_default_account", return_value={"plan_type": "pro"}))
+        original_save = self.service._save_accounts
+
+        def observe_save() -> None:
+            original_save()
+            self.saved_statuses.extend(str(item["status"]) for item in self.storage.load_accounts())
+
+        self.enterContext(mock.patch.object(self.service, "_save_accounts", side_effect=observe_save))
+        self.enterContext(self.client)
+        self.client.headers["Authorization"] = "Bearer offline-test-only"
+
+    def test_import_when_healthy_preflight_never_persists_enabled(self) -> None:
+        stages: list[str] = []
+
+        def observe_init():
+            stages.extend(str(item["status"]) for item in self.storage.load_accounts())
+            return {"limits_progress": [{"feature_name": "image_gen", "remaining": 8}]}
+
+        self.init.side_effect = observe_init
+
+        response = self.client.post("/api/accounts", json={"preserve_disabled": True, "accounts": [{"access_token": TOKEN, "status": DISABLED, "source_type": "codex"}]})
+
+        self.assertEqual(response.status_code, 200)
+        self.assertEqual(stages, [DISABLED])
+        self.assertTrue(self.saved_statuses)
+        self.assertEqual(set(self.saved_statuses), {DISABLED})
+        item = response.json()["items"][0]
+        self.assertEqual(item["status"], DISABLED)
+        self.assertEqual(item["quota"], 8)
+        self.assertEqual(item["limits_progress"][0]["remaining"], 8)
+        self.assertNotIn("refresh_token", item)
+        self.assertEqual(self.service.list_normal_tokens(), [])
+
+    def test_import_when_duplicate_exists_does_not_merge_or_preflight(self) -> None:
+        self.service.add_account_items([{"access_token": TOKEN, "status": NORMAL, "refresh_token": "synthetic-owner", "source_type": "web"}])
+        before = self.storage.file_path.read_bytes()
+        self.saved_statuses.clear()
+
+        response = self.client.post("/api/accounts", json={"preserve_disabled": True, "accounts": [{"access_token": TOKEN, "status": DISABLED, "source_type": "codex"}]})
+
+        self.assertEqual(response.status_code, 200)
+        self.assertEqual(response.json()["added"], 0)
+        self.assertEqual(response.json()["refreshed"], 0)
+        self.assertEqual(self.storage.file_path.read_bytes(), before)
+        self.assertEqual(self.saved_statuses, [])
+        self.me.assert_not_called()
+
+    def test_refresh_when_disabled_and_remote_limited_preserves_status_and_quota(self) -> None:
+        self.service.add_account_items([{"access_token": TOKEN, "status": DISABLED}])
+        self.init.return_value = {"limits_progress": [{"feature_name": "image_gen", "remaining": 0}]}
+        completed = Event()
+        finish = self.service.finish_refresh_progress
+
+        def observe_finish(*args, **kwargs) -> None:
+            finish(*args, **kwargs)
+            completed.set()
+
+        self.enterContext(mock.patch.object(self.service, "finish_refresh_progress", side_effect=observe_finish))
+
+        response = self.client.post("/api/accounts/refresh", json={"access_tokens": [TOKEN], "preserve_disabled": True})
+        self.assertTrue(completed.wait(5))
