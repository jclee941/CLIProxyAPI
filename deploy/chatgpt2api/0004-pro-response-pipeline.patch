index 0000000..2a5ed33
--- /dev/null
+++ b/services/protocol/text_stream.py
@@ -0,0 +1,104 @@
+from __future__ import annotations
+
+import copy
+from dataclasses import dataclass, field
+from typing import TypeAlias
+
+from fastapi import HTTPException
+
+JSONValue: TypeAlias = str | int | float | bool | None | list["JSONValue"] | dict[str, "JSONValue"]
+JSONObject: TypeAlias = dict[str, JSONValue]
+
+
+class TextResponseError(HTTPException):
+    def __init__(self) -> None:
+        self.error: JSONObject = {"error": {
+            "message": "The upstream text turn ended without a valid terminal answer. Do not automatically resubmit this request.",
+            "type": "server_error", "code": "incomplete_upstream_response", "param": None,
+        }}
+        super().__init__(status_code=502, detail=self.error)
+
+    def to_openai_error(self) -> JSONObject:
+        return self.error
+
+
+@dataclass
+class MessagePatchState:
+    message: JSONObject = field(default_factory=dict)
+    path: str = ""
+    operation: str = ""
+    new_message: bool = False
+
+    def normalize(self, event: JSONObject) -> JSONObject:
+        self.new_message = False
+        if self._apply(event):
+            return {"message": copy.deepcopy(self.message)}
+        return event
+
+    def _apply(self, event: JSONObject) -> bool:
+        value = event.get("v")
+        candidate = event.get("message")
+        if candidate is None and isinstance(value, dict):
+            candidate = value.get("message")
+        if isinstance(candidate, dict):
+            self.new_message = candidate.get("id") != self.message.get("id") or event.get("o") == "add" or not self.message
+            self.message = copy.deepcopy(candidate)
+            self.path = "/message/content/parts/0"
+            self.operation = "append"
+            return True
+        if event.get("o") == "patch" and isinstance(value, list):
+            changed = False
+            for operation in value:
+                if isinstance(operation, dict):
+                    changed = self._apply(operation) or changed
+            return changed
+
+        path = event.get("p", self.path)
+        operation = event.get("o", self.operation)
+        if not isinstance(path, str) or not path.startswith("/message/"):
+            return False
+        if operation not in ("add", "replace", "append"):
+            return False
+        self.path = path
+        self.operation = str(operation)
+        if not self.message:
+            self.message = {"author": {"role": "assistant"}, "content": {"parts": [""]}}
+        segments = path.removeprefix("/message/").split("/")
+        target: JSONValue = self.message
+        for segment in segments[:-1]:
+            if isinstance(target, dict):
+                target = target.get(segment)
+            elif isinstance(target, list) and segment.isdigit() and int(segment) < len(target):
+                target = target[int(segment)]
+            else:
+                return False
+        key = segments[-1]
+        if isinstance(target, dict):
+            previous = target.get(key)
+            if operation == "append":
+                if not isinstance(previous, str) or not isinstance(value, str):
+                    return False
+                value = previous + value
+            target[key] = copy.deepcopy(value)
+            return True
+        if isinstance(target, list) and key.isdigit() and int(key) < len(target):
+            index = int(key)
+            previous = target[index]
+            if operation == "append":
+                if not isinstance(previous, str) or not isinstance(value, str):
+                    return False
+                value = previous + value
+            target[index] = copy.deepcopy(value)
+            return True
+        return False
+
+    @property
+    def terminal(self) -> bool:
+        return self.message.get("status") == "finished_successfully" and self.message.get("end_turn") is True
+
+    @property
+    def failed(self) -> bool:
+        metadata = self.message.get("metadata")
+        return self.message.get("status") in ("failed", "error", "cancelled") or (
+            isinstance(metadata, dict) and metadata.get("is_error") is True
+        )
