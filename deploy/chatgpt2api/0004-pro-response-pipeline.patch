+
+    def test_status_without_end_turn_does_not_finish_when_explicitly_false(self) -> None:
+        frames = [message_frame("partial"), '{"p":"/message/status","o":"replace","v":"finished_successfully"}', "[DONE]"]
+        self.backend.stream_conversation.return_value = iter(frames)
+        with self.assertRaises(HTTPException):
+            _ = conversation.collect_text(self.backend, conversation.ConversationRequest(model="gpt-6-pro"))
+
+    def test_success_status_does_not_finish_when_turn_marker_is_absent(self) -> None:
+        frames = [json.dumps({"message": {
+            "author": {"role": "assistant"}, "channel": "final",
+            "content": {"content_type": "text", "parts": ["partial"]},
+            "status": "finished_successfully",
+        }}), "[DONE]"]
+        self.backend.stream_conversation.return_value = iter(frames)
+        with self.assertRaises(HTTPException):
+            _ = conversation.collect_text(self.backend, conversation.ConversationRequest(model="gpt-6-pro"))
+
+    def http_client(self) -> TestClient:
+        _ = self.enterContext(mock.patch("api.ai.require_identity", return_value={"id": "offline", "role": "admin"}))
+        _ = self.enterContext(mock.patch("services.log_service.LoggedCall.log"))
+        app = FastAPI()
+        install_exception_handlers(app)
+        app.include_router(create_router())
