+from __future__ import annotations
+
+import json
+import unittest
+from typing import override
+from unittest import mock
+
+from fastapi import FastAPI, HTTPException
+from fastapi.testclient import TestClient
+
+from api.ai import create_router
+from api.errors import install_exception_handlers
+from services.protocol import conversation, openai_v1_chat_complete
+from services.protocol.chat_completion_cache import ChatCompletionCache
+
+
+def message_frame(text: str = "", channel: str = "final") -> str:
+    return json.dumps({"p": "", "o": "add", "v": {"message": {
+        "id": channel, "author": {"role": "assistant"}, "channel": channel,
+        "recipient": "all", "content": {"content_type": "text", "parts": [text]},
+        "status": "in_progress", "end_turn": False,
+    }}})
+
+
+def terminal_frame(status: str = "finished_successfully") -> str:
+    return json.dumps({"p": "", "o": "patch", "v": [
+        {"p": "/message/status", "o": "replace", "v": status},
+        {"p": "/message/end_turn", "o": "replace", "v": True},
+    ]})
+
+
+def compressed_frames() -> list[str]:
+    return [message_frame(),
+            '{"p":"/message/content/parts/0","o":"append","v":""}',
+            '{"v":"OK"}', terminal_frame(), "[DONE]"]
+
+
+class ProResponsePipelineTests(unittest.TestCase):
+    def __init__(self, methodName: str = "runTest") -> None:
+        super().__init__(methodName)
+        self.backend: mock.Mock = mock.Mock()
+        self.accounts: mock.Mock = mock.Mock()
+        self.cache: ChatCompletionCache = ChatCompletionCache()
+
+    @override
+    def setUp(self) -> None:
+        self.backend = mock.Mock(access_token="offline-fixture")
+        _ = self.enterContext(mock.patch.object(
+            conversation, "OpenAIBackendAPI", return_value=self.backend))
+        self.accounts = self.enterContext(mock.patch.object(conversation, "account_service"))
+        self.enterContext(mock.patch.object(conversation, "count_text_tokens", return_value=1))
+        self.enterContext(mock.patch.object(openai_v1_chat_complete, "count_text_tokens", return_value=1))
+        self.enterContext(mock.patch.object(openai_v1_chat_complete, "count_message_text_tokens", return_value=1))
+        self.enterContext(mock.patch.object(openai_v1_chat_complete, "count_message_image_tokens", return_value=0))
+        self.cache = ChatCompletionCache()
+        self.enterContext(mock.patch.object(self.cache, "_settings", return_value={
+            "enabled": True, "ttl_seconds": 60, "max_entries": 10,
+            "stream_cache": True, "dedupe_inflight": True,
+        }))
+        self.enterContext(mock.patch.object(openai_v1_chat_complete, "chat_completion_cache", self.cache))
+
+    def test_final_answer_when_first_nonempty_patch_omits_path(self) -> None:
+        self.backend.stream_conversation.return_value = iter(compressed_frames())
+        result = conversation.collect_text(self.backend, conversation.ConversationRequest(model="gpt-6-pro"))
+        self.assertEqual(result, "OK")
+
+    def test_private_patches_when_reasoning_precedes_final(self) -> None:
+        frames = [message_frame("", "analysis"),
+                  '{"p":"/message/content/parts/0","o":"append","v":"private"}',
+                  *compressed_frames()]
+        self.backend.stream_conversation.return_value = iter(frames)
+        result = conversation.collect_text(self.backend, conversation.ConversationRequest(model="gpt-6-pro"))
+        self.assertEqual(result, "OK")
+
+    def test_terminal_errors_when_answer_is_missing_failed_or_truncated(self) -> None:
+        cases = [[], ["[DONE]"], [message_frame(), terminal_frame(), "[DONE]"],
+                 [message_frame("partial"), "[DONE]"],
+                 [message_frame("partial"), terminal_frame("failed"), "[DONE]"]]
+        for frames in cases:
+            with self.subTest(frames=len(frames)):
+                self.backend.stream_conversation.return_value = iter(frames)
+                with self.assertRaises(HTTPException) as raised:
+                    conversation.collect_text(self.backend, conversation.ConversationRequest(model="gpt-6-pro"))
+                self.assertEqual(raised.exception.status_code, 502)
+        self.accounts.mark_text_used.assert_not_called()
+        self.accounts.refresh_access_token.assert_not_called()
+
+    def test_invalid_success_is_not_cached_when_requests_repeat(self) -> None:
+        self.backend.stream_conversation.side_effect = lambda **kwargs: iter(["[DONE]"])
+        body = {"model": "gpt-6-pro", "messages": [{"role": "user", "content": "fixture"}]}
+        for stream in (False, True):
+            with self.subTest(stream=stream):
+                for _attempt in range(2):
+                    with self.assertRaises(HTTPException):
+                        result = openai_v1_chat_complete.handle({**body, "stream": stream})
+                        if stream:
+                            list(result)
+        self.assertEqual(self.backend.stream_conversation.call_count, 4)
+
+    def test_valid_answer_remains_cached_when_requests_repeat(self) -> None:
+        self.backend.stream_conversation.side_effect = lambda **kwargs: iter(compressed_frames())
+        body = {"model": "gpt-6-pro", "messages": [{"role": "user", "content": "fixture"}]}
+        for stream in (False, True):
+            with self.subTest(stream=stream):
+                for _attempt in range(2):
+                    result = openai_v1_chat_complete.handle({**body, "stream": stream})
+                    content = result["choices"][0]["message"]["content"] if isinstance(result, dict) else openai_v1_chat_complete.collect_chat_content(result)
+                    self.assertEqual(content, "OK")
+        self.assertEqual(self.backend.stream_conversation.call_count, 2)
+
+    def test_final_answer_when_text_is_a_json_string_payload(self) -> None:
+        frames = [message_frame(),
+                  '{"p":"/message/content/parts/0","o":"append","v":""}',
+                  '"OK"', terminal_frame(), "[DONE]"]
+        self.backend.stream_conversation.return_value = iter(frames)
+        result = conversation.collect_text(self.backend, conversation.ConversationRequest(model="gpt-6-pro"))
+        self.assertEqual(result, "OK")
+
+    def test_tool_patches_stay_private_when_final_answer_follows(self) -> None:
+        frames = [json.dumps({"message": {
+            "author": {"role": "assistant"}, "recipient": "web", "channel": "analysis",
+            "content": {"content_type": "code", "text": ""},
+        }}), '{"p":"/message/content/text","o":"append","v":"private-tool"}',
+                  *compressed_frames()]
+        self.backend.stream_conversation.return_value = iter(frames)
+        result = conversation.collect_text(self.backend, conversation.ConversationRequest(model="gpt-6-pro"))
+        self.assertEqual(result, "OK")
+
+    def test_tool_failure_does_not_discard_a_later_valid_final_answer(self) -> None:
+        frames = [json.dumps({"message": {
+            "author": {"role": "tool"}, "recipient": "all", "status": "failed",
+            "metadata": {"is_error": True},
+            "content": {"content_type": "text", "parts": ["tool-fixture-error"]},
+        }}), *compressed_frames()]
+        self.backend.stream_conversation.return_value = iter(frames)
+        result = conversation.collect_text(self.backend, conversation.ConversationRequest(model="gpt-6-pro"))
+        self.assertEqual(result, "OK")
+
+    def test_refusal_text_is_preserved_when_moderation_is_blocked(self) -> None:
+        frames = ['{"type":"moderation","moderation_response":{"blocked":true}}',
+                  message_frame("I cannot assist with that request."), terminal_frame(), "[DONE]"]
+        self.backend.stream_conversation.return_value = iter(frames)
+        result = conversation.collect_text(self.backend, conversation.ConversationRequest(model="gpt-6-pro"))
+        self.assertEqual(result, "I cannot assist with that request.")
+
+    def test_full_message_answers_when_other_models_complete(self) -> None:
+        for model in ("auto", "gpt-5-3-mini", "o3-pro", "gpt-6-pro"):
+            with self.subTest(model=model):
+                frames = [json.dumps({"message": {
+                    "author": {"role": "assistant"}, "recipient": "all",
+                    "content": {"content_type": "text", "parts": ["OK"]},
+                    "status": "finished_successfully", "end_turn": True,
+                }}), "[DONE]"]
+                self.backend.stream_conversation.return_value = iter(frames)
+                result = conversation.collect_text(self.backend, conversation.ConversationRequest(model=model))
+                self.assertEqual(result, "OK")
+
+    def test_partial_stream_emits_error_without_success_stop_when_terminal_is_missing(self) -> None:
+        from utils.helper import sse_json_stream
+
+        self.backend.stream_conversation.return_value = iter([message_frame("partial"), "[DONE]"])
+        chunks = openai_v1_chat_complete.stream_text_chat_completion(self.backend, [], "gpt-6-pro")
