index 0000000..85c816d
--- /dev/null
+++ b/test/test_english_request_locale.py
@@ -0,0 +1,152 @@
+"""Offline locale checks: parse source without importing the authenticated backend."""
+
+from __future__ import annotations
+
+import ast
+import unittest
+from collections.abc import Callable
+from pathlib import Path
+from typing import Final
+
+
+ROOT: Final = Path(__file__).resolve().parents[1]
+BACKEND: Final = ROOT / "services/openai_backend_api.py"
+CONVERSATION: Final = ROOT / "services/protocol/conversation.py"
+
+
+def backend_method(name: str) -> ast.FunctionDef:
+    tree = ast.parse(BACKEND.read_text(encoding="utf-8"))
+    backend = next(
+        node for node in tree.body
+        if isinstance(node, ast.ClassDef) and node.name == "OpenAIBackendAPI"
+    )
+    return next(
+        node for node in backend.body
+        if isinstance(node, ast.FunctionDef) and node.name == name
+    )
+
+
+def header_value(method_name: str, header_name: str) -> str:
+    """Extract the literal from the actual header update or return dictionary."""
+    method = backend_method(method_name)
+    dictionaries: list[ast.Dict] = []
+    for node in ast.walk(method):
+        if method_name == "__init__":
+            if isinstance(node, ast.Call) and ast.unparse(node.func) == "self.session.headers.update":
+                dictionaries.extend(arg for arg in node.args if isinstance(arg, ast.Dict))
+        elif isinstance(node, ast.Return) and isinstance(node.value, ast.Dict):
+            dictionaries.append(node.value)
+    values = [
+        value
+        for headers in dictionaries
+        for key, value in zip(headers.keys, headers.values, strict=True)
+        if isinstance(key, ast.Constant) and key.value == header_name
+    ]
+    match values:
+        case [ast.Constant(value=str(value))]:
+            return value
+        case _:
+            raise AssertionError((method_name, header_name, values))
+
+
+def pure_function(node: ast.FunctionDef) -> Callable[..., str]:
+    """Execute only an extracted pure helper, never module imports or construction."""
+    node.decorator_list = []
+    module = ast.Module(body=[node], type_ignores=[])
+    namespace: dict[str, Callable[..., str]] = {}
+    exec(compile(module, "<offline-pure-helper>", "exec"), namespace)
+    return namespace[node.name]
+
+
+def formatted_message(node: ast.expr, seconds_name: str) -> str:
+    """Evaluate only a message expression with a fixed local duration."""
+    assignment = ast.Assign(targets=[ast.Name(id="message", ctx=ast.Store())], value=node)
+    module = ast.fix_missing_locations(ast.Module(body=[assignment], type_ignores=[]))
+    namespace: dict[str, str] = {}
+    exec(compile(module, "<offline-message>", "exec"), {seconds_name: 120.0}, namespace)
+    return namespace["message"]
+
+
+class EnglishRequestLocaleTests(unittest.TestCase):
+    def test_accept_language_when_ordinary_session_headers_are_built(self) -> None:
+        # Given: the real constructor's header dictionary, without running it.
+        # When: reading its HTTP language preference.
+        value = header_value("__init__", "Accept-Language")
+        # Then: prefer US English, with English as the fallback.
+        self.assertEqual(value, "en-US,en;q=0.9")
+
+    def test_oai_language_when_ordinary_session_headers_are_built(self) -> None:
+        # Given: the real constructor's header dictionary, without running it.
+        # When: reading its application locale.
+        value = header_value("__init__", "OAI-Language")
+        # Then: request the US English locale.
+        self.assertEqual(value, "en-US")
+
+    def test_accept_language_when_document_headers_are_built(self) -> None:
+        # Given: the document header builder, without running any bootstrap code.
+        # When: reading only its HTTP language preference.
+        value = header_value("_bootstrap_headers", "Accept-Language")
+        # Then: use the same English preference as ordinary API requests.
+        self.assertEqual(value, "en-US,en;q=0.9")
+
+    def test_english_error_when_image_poll_budget_expires(self) -> None:
+        # Given: the actual timeout exception's message expression.
+        method = backend_method("_poll_image_results")
+        error = next(
+            node for node in ast.walk(method)
+            if isinstance(node, ast.Call) and ast.unparse(node.func) == "ImagePollTimeoutError"
+        )
+        # When: formatting its controlled text without executing polling.
+        message = formatted_message(error.args[0], "timeout_secs")
+        # Then: expose English text and retain the configured duration.
+        self.assertTrue(message.isascii(), message)
+        self.assertIn("120.0", message)
+
+    def test_english_error_when_image_stream_budget_expires(self) -> None:
+        # Given: the actual stream timeout message, without a stream or timer.
+        method = backend_method("_iter_sse_payloads_capped")
+        assignment = next(
+            node for node in ast.walk(method)
+            if isinstance(node, ast.Assign)
+            and any(isinstance(target, ast.Name) and target.id == "timeout_message" for target in node.targets)
+        )
+        # When: formatting its controlled text with a fixed local duration.
+        message = formatted_message(assignment.value, "hard_cap_secs")
+        # Then: expose English text and retain the configured duration.
+        self.assertTrue(message.isascii(), message)
+        self.assertIn("120", message)
+
+    def test_user_content_when_image_prompt_is_built(self) -> None:
+        # Given: the isolated pass-through helper and mixed-language user input.
+        tree = ast.parse(CONVERSATION.read_text(encoding="utf-8"))
+        node = next(
+            node for node in tree.body
+            if isinstance(node, ast.FunctionDef) and node.name == "build_image_prompt"
+        )
+        build_prompt = pure_function(node)
+        user_text = "保留文字 / 글자 유지 / 文字を保持 / Keep text"
+        # When: building a prompt with non-default size and quality.
+        result = build_prompt("  " + user_text + "  ", "1792x1024", "high")
+        # Then: retain user content and the existing whitespace-only normalization.
+        self.assertEqual(result, user_text)
+
+    def test_user_content_when_editable_requirements_are_appended(self) -> None:
+        # Given: the isolated helper and caller-supplied requirements.
+        build_prompt = pure_function(backend_method("_editable_prompt"))
+        user_text = "保留文字 / 글자 유지 / 文字を保持"
+        # When: adding requirements to the selected built-in task prompt.
+        result = build_prompt("fixed-task", user_text)
+        # Then: preserve the supplied requirements rather than translating them.
+        self.assertTrue(result.endswith(user_text))
+
+    def test_selected_prompt_when_extra_requirements_are_empty(self) -> None:
+        # Given: an already selected task prompt and empty additional input.
+        build_prompt = pure_function(backend_method("_editable_prompt"))
+        # When: building the final prompt.
+        result = build_prompt("fixed-task", "  ")
+        # Then: retain the selected task without injecting extra instructions.
+        self.assertEqual(result, "fixed-task")
+
+
+if __name__ == "__main__":
+    _ = unittest.main()
