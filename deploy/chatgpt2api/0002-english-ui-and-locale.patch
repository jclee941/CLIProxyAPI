+from __future__ import annotations
+
+import tempfile
+import unittest
+import os
+from pathlib import Path
+from unittest.mock import patch
+
+from fastapi import FastAPI, HTTPException
+from fastapi.testclient import TestClient
+
+os.environ.setdefault("CHATGPT2API_AUTH_KEY", "test-auth")
+
+from services.auth_service import AuthService
+from services.content_filter import check_request
+from services.image_task_service import ImageTaskService, TASK_STATUS_ERROR
+from services.storage.json_storage import JSONStorageBackend
+from services.log_service import LogService
+from services.oauth_login_service import OAuthLoginError, OAuthLoginService
+import api.accounts as accounts_api
+import api.ai as ai_api
+import api.image_tasks as image_tasks_api
+
+
+class EnglishBackendMessagesTests(unittest.TestCase):
+    def test_auth_key_validation_errors_are_english(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp_dir:
+            service = AuthService(JSONStorageBackend(Path(tmp_dir) / "accounts.json"))
+
+            with self.assertRaisesRegex(ValueError, "Enter a new user key"):
+                service._build_key_hash_locked("")
+
+            _, raw_key = service.create_key(role="user", name="Alice")
+            with self.assertRaisesRegex(ValueError, "This user key already exists"):
+                service._build_key_hash_locked(raw_key)
+
+    def test_content_filter_errors_are_english(self) -> None:
+        with patch.dict("services.content_filter.config.data", {"sensitive_words": ["blocked"]}):
+            with self.assertRaises(HTTPException) as raised:
+                check_request("blocked request")
+
+        self.assertEqual(raised.exception.status_code, 400)
+        self.assertEqual(raised.exception.detail, {"error": "Sensitive word detected; task rejected"})
+
+    def test_recovered_image_task_has_english_error_without_changing_status(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp_dir:
+            path = Path(tmp_dir) / "image_tasks.json"
+            path.write_text(
+                '{"tasks":[{"id":"task-1","owner_id":"user-1","status":"queued","mode":"generate"}]}',
+                encoding="utf-8",
+            )
+
+            service = ImageTaskService(path)
+            task = service.list_tasks({"id": "user-1"}, ["task-1"])["items"][0]
+
+        self.assertEqual(task["status"], TASK_STATUS_ERROR)
+        self.assertEqual(task["error"], "Service restarted; unfinished image task was interrupted")
+
+    def test_resume_poll_accepts_english_and_legacy_timeout_errors(self) -> None:
+        for message in ("Image generation timed out", "TIMEOUT waiting for images", "图片生成超时"):
+            with self.subTest(message=message), tempfile.TemporaryDirectory() as tmp_dir:
+                # Given a failed task, without starting any upstream worker.
+                service = ImageTaskService(Path(tmp_dir) / "tasks.json")
+                service._tasks["user-1:task-1"] = {
+                    "id": "task-1", "owner_id": "user-1", "status": "error",
+                    "error": message, "conversation_id": "conversation-1",
+                }
+                with patch("services.image_task_service.threading.Thread.start") as start:
+                    # When the owner resumes polling.
+                    task = service.resume_poll({"id": "user-1"}, "task-1")
+                # Then all supported timeout spellings resume the same task.
+                self.assertEqual(task["status"], "running")
+                self.assertEqual(task["conversation_id"], "conversation-1")
+                start.assert_called_once_with()
+
+    def test_resume_poll_rejects_non_timeout_error(self) -> None:
+        with tempfile.TemporaryDirectory() as tmp_dir:
+            service = ImageTaskService(Path(tmp_dir) / "tasks.json")
+            service._tasks["user-1:task-1"] = {
+                "id": "task-1", "owner_id": "user-1", "status": "error",
+                "error": "Content policy violation", "conversation_id": "conversation-1",
+            }
+            with patch("services.image_task_service.threading.Thread.start") as start:
+                with self.assertRaisesRegex(ValueError, "task error is not a timeout error"):
+                    service.resume_poll({"id": "user-1"}, "task-1")
+            start.assert_not_called()
+            self.assertEqual(service._tasks["user-1:task-1"]["status"], "error")
+
+    def test_image_task_log_separates_label_and_outcome(self) -> None:
+        for mode, label in (("generate", "Text to image"), ("edit", "Image to image")):
+            for suffix in ("Call completed", "Call failed", "Call completed (continued polling)", "Call failed (continued polling)"):
+                with self.subTest(mode=mode, suffix=suffix), tempfile.TemporaryDirectory() as tmp_dir:
+                    service = ImageTaskService(Path(tmp_dir) / "tasks.json")
+                    logs = LogService(Path(tmp_dir) / "logs.jsonl")
+                    with patch("services.image_task_service.log_service", logs):
+                        service._log_call({"id": "user-1"}, mode, "gpt-image-2", 0, suffix)
+                    self.assertEqual(logs.list()[0]["summary"], f"{label} {suffix}")
+
+    def test_filter_api_keeps_error_schema_and_separates_log_label(self) -> None:
+        for module, endpoint, label in (
+            (ai_api, "/v1/images/generations", "Text to image"),
+            (image_tasks_api, "/api/image-tasks/generations", "Text to image task"),
+        ):
+            with self.subTest(endpoint=endpoint), tempfile.TemporaryDirectory() as tmp_dir:
+                app = FastAPI()
+                app.include_router(module.create_router())
+                logs = LogService(Path(tmp_dir) / "logs.jsonl")
+                with (
+                    patch.object(module, "require_identity", return_value={"id": "user-1"}),
+                    patch.dict("services.content_filter.config.data", {"sensitive_words": ["blocked"]}),
+                    patch("services.log_service.log_service", logs),
+                    TestClient(app) as client,
+                ):
+                    response = client.post(endpoint, json={"prompt": "blocked", "client_task_id": "task-1"})
+                self.assertEqual(response.status_code, 400)
+                self.assertEqual(response.json(), {"detail": {"error": "Sensitive word detected; task rejected"}})
+                self.assertEqual(logs.list()[0]["summary"], f"{label} Call failed")
+                self.assertEqual(logs.list()[0]["detail"]["status"], "failed")
+
+    def test_oauth_api_missing_callback_error_is_english(self) -> None:
+        app = FastAPI()
+        app.include_router(accounts_api.create_router())
+        with (
+            patch.object(accounts_api, "require_admin", return_value={"id": "admin"}),
+            patch.object(accounts_api, "oauth_login_service", OAuthLoginService()),
+            patch.object(OAuthLoginService, "_exchange_code", side_effect=AssertionError("Unexpected network path")) as exchange,
+            TestClient(app) as client,
+        ):
+            response = client.post("/api/accounts/oauth/finish", json={})
+        self.assertEqual(response.status_code, 400)
+        self.assertEqual(response.json(), {"detail": {"error": "Missing code or callback URL"}})
+        exchange.assert_not_called()
+
+    def test_oauth_missing_code_fallback_is_english(self) -> None:
+        with self.assertRaisesRegex(OAuthLoginError, "Callback URL has no code parameter"):
+            OAuthLoginService._extract_code_from_callback("https://example.invalid/callback")
+
+    def test_oauth_preserves_provider_error_text(self) -> None:
+        with self.assertRaisesRegex(OAuthLoginError, "用户取消"):
+            OAuthLoginService._extract_code_from_callback("https://example.invalid/callback?error_description=用户取消")
