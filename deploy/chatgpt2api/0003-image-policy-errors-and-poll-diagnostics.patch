@@ -0,0 +1,133 @@
+"""Credential-free execution of real polling definitions with a virtual clock."""
+from __future__ import annotations
+
+import ast
+import json
+import logging
+import re
+from pathlib import Path
+from types import ModuleType, SimpleNamespace
+from unittest import mock
+
+from utils.log import Logger
+
+type JSONValue = None | bool | int | float | str | list[JSONValue] | dict[str, JSONValue]
+
+ROOT = Path(__file__).resolve().parents[1]
+CONVERSATION_ID = "12345678-1234-4234-8234-123456789abc"
+
+
+class Clock:
+    """Advance only when polling requests a sleep; record the exact schedule."""
+
+    def __init__(self) -> None:
+        self.now = 0.0
+        self.sleeps: list[float] = []
+
+    def time(self) -> float:
+        return self.now
+
+    def sleep(self, seconds: float) -> None:
+        self.sleeps.append(seconds)
+        self.now += seconds
+
+
+class EventSink(logging.Handler):
+    """Capture the real logger's serialized output without printing payloads."""
+
+    def __init__(self) -> None:
+        super().__init__()
+        self.events: list[dict[str, JSONValue]] = []
+        self.levels: list[int] = []
+
+    def emit(self, record: logging.LogRecord) -> None:
+        self.events.append(json.loads(record.getMessage()))
+        self.levels.append(record.levelno)
+
+
+def load_runtime(logger: Logger, clock: Clock) -> ModuleType:
+    """Compile source AST, excluding all authenticated imports and constructors."""
+    runtime = ModuleType("offline_image_poll")
+    runtime.__dict__.update(
+        json=json, re=re, logger=logger, time=clock,
+        random=SimpleNamespace(uniform=lambda _low, _high: 0.0),
+        config=SimpleNamespace(
+            image_poll_initial_wait_secs=0.0, image_poll_interval_secs=1.0,
+            image_settle_enabled=False, image_settle_secs=1.0,
+            image_check_before_hit_enabled=False,
+        ),
+        requests=SimpleNamespace(exceptions=SimpleNamespace(RequestException=ConnectionError)),
+        _UPSTREAM_BODY_LOG_LIMIT=500,
+    )
+    helper = ast.parse((ROOT / "utils/helper.py").read_text(encoding="utf-8"))
+    nodes: list[ast.stmt] = [
+        node for node in helper.body
+        if isinstance(node, (ast.ClassDef, ast.FunctionDef))
+        and node.name in {"UpstreamHTTPError", "ensure_ok"}
+    ]
+    source = ast.parse((ROOT / "services/openai_backend_api.py").read_text(encoding="utf-8"))
+    methods = {
+        "_add_unique", "_extract_image_reference_ids", "_has_image_asset_pointer",
+        "_extract_image_tool_records", "_find_content_policy_error_in_conversation",
+        "_poll_image_results", "_query_backend_tasks", "check_task_error",
+        "resolve_conversation_image_urls",
+    }
+    constants = {"FILE_SERVICE_ID_RE", "REAL_IMAGE_FILE_ID_RE", "SEDIMENT_ID_RE", "_CONTENT_POLICY_KEYWORDS"}
+    for node in source.body:
+        if isinstance(node, ast.ImportFrom) and node.module == "services.image_poll_diagnostics":
+            nodes.append(node)
+        elif isinstance(node, ast.Assign) and any(
+            isinstance(target, ast.Name) and target.id in constants for target in node.targets
+        ):
+            nodes.append(node)
+        elif isinstance(node, (ast.ClassDef, ast.FunctionDef)) and node.name in {
+            "ImageTaskError", "ImagePollTimeoutError", "ImageContentPolicyError", "_is_content_policy_error",
+        }:
+            nodes.append(node)
+        elif isinstance(node, ast.ClassDef) and node.name == "OpenAIBackendAPI":
+            node.body = [item for item in node.body if isinstance(item, ast.FunctionDef) and item.name in methods]
+            nodes.append(node)
+    exec(compile(ast.Module(body=nodes, type_ignores=[]), "<offline-image-poll>", "exec"), runtime.__dict__)
+    return runtime
+
+
+def conversation(content: dict[str, JSONValue], *, role: str = "assistant") -> dict[str, JSONValue]:
