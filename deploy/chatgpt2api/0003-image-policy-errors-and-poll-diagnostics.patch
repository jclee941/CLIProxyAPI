+# /// script
+# requires-python = ">=3.13"
+# dependencies = []
+# ///
+# Run from the snapshot root: .venv/bin/python -B -m test.run_image_poll_offline
+"""Run deterministic polling scenarios and existing tests without real auth storage."""
+from __future__ import annotations
+
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+from test.image_poll_harness import ROOT, PollDriver, conversation
+
+
+def run_scenarios() -> None:
+    absent = PollDriver()
+    lookup_error = PollDriver()
+    lookup_error.backend.session.get.side_effect = lookup_error.runtime.UpstreamHTTPError("fixture", 403, "private-fixture")
+    text_only = PollDriver()
+    text_only.backend._get_conversation.return_value = conversation({"content_type": "text", "parts": ["private-fixture"]})
+    unsupported = PollDriver()
+    unsupported.backend._get_conversation.return_value = conversation({"content_type": "image_url", "image_url": {"url": "https://offline.invalid/private-fixture"}})
+    image = PollDriver()
+    image.backend._get_conversation.return_value = conversation({"content_type": "image_asset_pointer", "asset_pointer": "file-service://file-private-fixture"})
+    cases = (
+        ("no_matching_task", absent, "timeout", 0, 0, 0),
+        ("task_lookup_error", lookup_error, "timeout", 3, 0, 0),
+        ("terminal_text", text_only, "timeout", 0, 1, 0),
+        ("image_shape_without_record", unsupported, "timeout", 0, 0, 1),
+        ("image_success", image, "success", 0, 0, 1),
+    )
+    for name, driver, outcome, failures, terminal_text, structures in cases:
+        result = driver.run()
+        summaries = driver.events("image_poll_summary")
+        assert len(summaries) == 1
+        summary = summaries[0]
+        assert summary["outcome"] == outcome
+        assert summary["task_query_failure_count"] == failures
+        assert summary["assistant_terminal_text_count"] == terminal_text
+        assert summary["image_structure_count"] == structures
+        assert "private-fixture" not in json.dumps(driver.sink.events), "unsafe event serialization"
+        if outcome == "success":
+            assert result == (["file-private-fixture"], [])
+        else:
+            assert result == "timeout"
+        print(json.dumps({"scenario": name, "result": "PASS", "summary": summary}))
+
+
+def run_sandbox_tests() -> int:
+    # Copy Python source only: never config.json, data/, credentials, or runtime state.
+    with tempfile.TemporaryDirectory(prefix="image-poll-offline-", dir="/tmp/opencode") as directory:
+        sandbox = Path(directory)
+        for name in ("api", "services", "utils", "test"):
+            for source in (ROOT / name).rglob("*.py"):
+                target = sandbox / source.relative_to(ROOT)
+                target.parent.mkdir(parents=True, exist_ok=True)
+                shutil.copyfile(source, target)
+        command = """
+import socket
+import unittest
+from unittest import mock
+from curl_cffi import requests
+with (
+    mock.patch.object(socket.socket, 'connect', side_effect=AssertionError('offline network forbidden')),
+    mock.patch.object(requests.Session, 'request', side_effect=AssertionError('offline HTTP forbidden')),
+):
+    suite = unittest.defaultTestLoader.loadTestsFromNames([
+        'test.test_image_poll_diagnostics',
+        'test.test_image_guardrail_refusal',
+        'test.test_multi_image_results',
+        'test.test_image_remove_conversation',
+        'test.test_english_request_locale',
+    ])
+    result = unittest.TextTestRunner(verbosity=1).run(suite)
+    raise SystemExit(not result.wasSuccessful())
+"""
+        result = subprocess.run(
+            [sys.executable, "-B", "-c", command], cwd=sandbox,
+            env={"PATH": os.defpath, "STORAGE_BACKEND": "json", "PYTHONDONTWRITEBYTECODE": "1",
+                 "CHATGPT2API_AUTH_KEY": "offline-test-only"},
+            capture_output=True, text=True, check=False,
+        )
+        # Existing tests emit synthetic fixture logs; retain only runner lines on success.
+        output = result.stdout + result.stderr
+        if result.returncode:
+            print(output)
+        else:
+            for line in output.splitlines():
+                if line.startswith("Ran ") or line == "OK":
+                    print(line)
+        return result.returncode
+
+
+if __name__ == "__main__":
+    run_scenarios()
+    raise SystemExit(run_sandbox_tests())
