+"""Allowlisted projections of untrusted image polling data; never log payloads."""
+from __future__ import annotations
+
+import re
+from collections.abc import Sequence
+from typing import Final, Literal, Protocol, TypedDict
+
+type JSONValue = None | bool | int | float | str | list[JSONValue] | dict[str, JSONValue]
+type Fields = dict[str, str | int | bool | None | dict[str, int]]
+
+STATUSES: Final = (
+    "pending", "queued", "running", "in_progress", "completed", "success", "failed",
+    "error", "cancelled", "finished", "finished_successfully", "finished_partial_completion",
+)
+CONTENT_TYPES: Final = ("text", "multimodal_text", "image_asset_pointer", "image", "image_url", "code", "execution_output")
+ROLES: Final = ("system", "developer", "user", "assistant", "tool")
+ERROR_TYPES: Final = (
+    "UpstreamHTTPError", "RequestException", "RequestsError", "HTTPError", "Timeout",
+    "ConnectTimeout", "ReadTimeout", "ConnectionError", "JSONDecodeError",
+    "ValueError", "TypeError", "KeyError", "AttributeError", "RuntimeError",
+)
+
+
+class EventLogger(Protocol):
+    def info(self, message: Fields) -> None: ...
+
+
+class ErrorFields(TypedDict):
+    error_type: str
+    status_code: int | None
+
+
+def _label(value: JSONValue, allowed: tuple[str, ...]) -> str:
+    return next((label for label in allowed if value == label), "other")
+
+
+def _mapping(value: JSONValue) -> dict[str, JSONValue]:
+    return value if isinstance(value, dict) else {}
+
+
+def _image_structure_count(value: JSONValue) -> int:
+    """Count known image-shaped dictionaries, not IDs or successful generations."""
+    pending = [value]
+    count = 0
+    while pending:
+        item = pending.pop()
+        if isinstance(item, dict):
+            count += int(
+                item.get("content_type") in ("image_asset_pointer", "image", "image_url")
+                or "asset_pointer" in item or "image_url" in item
+            )
+            pending.extend(item.values())
+        elif isinstance(item, list):
+            pending.extend(item)
+    return count
+
+
+class ImagePollDiagnostics:
+    """Per-poll mutable counters and safe snapshots, independent of policy decisions."""
+
+    def __init__(self, conversation_id: str, logger: EventLogger) -> None:
+        self.conversation_id = conversation_id if re.fullmatch(
+            r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}", conversation_id
+        ) else "other"
+        self.logger = logger
+        self.attempt = 0
+        self.file_count = 0
+        self.sediment_count = 0
+        self.task_query_failure_count = 0
+        self.task_check_failure_count = 0
+        self.task_error_observed_count = 0
+        self.conversation_query_failure_count = 0
+        self._states: dict[str, Fields] = {}
+
+    @staticmethod
+    def error_fields(exc: Exception) -> ErrorFields:
+        status = getattr(exc, "status_code", None)
+        return {
+            "error_type": _label(type(exc).__name__, ERROR_TYPES),
+            "status_code": status if type(status) is int and 100 <= status <= 599 else None,
+        }
+
+    def _state(self, stage: str, fields: Fields) -> None:
+        if self._states.get(stage) != fields:
+            self.logger.info({
+                "event": f"image_poll_{stage}_state", "conversation_id": self.conversation_id,
+                "attempt": self.attempt, **fields,
+            })
+        self._states[stage] = fields
+
+    def task_state(self, tasks: Sequence[JSONValue] | None, error_count: int, exc: Exception | None = None) -> None:
+        status_counts: dict[str, int] = {}
+        for task in tasks or []:
+            status = _label(_mapping(task).get("status"), STATUSES)
+            status_counts[status] = status_counts.get(status, 0) + 1
+        self.task_error_observed_count += error_count
+        fields: Fields = {
+            "task_query": "error" if tasks is None else "ok",
+            "matched_task_count": None if tasks is None else len(tasks),
+            "task_status_counts": status_counts, "task_error_count": error_count,
+        }
+        if exc is not None:
+            error = self.error_fields(exc)
+            fields["error_type"] = error["error_type"]
+            fields["status_code"] = error["status_code"]
+            fields["error_stage"] = "task_query" if tasks is None else "task_check"
+            self.task_query_failure_count += int(tasks is None)
+            self.task_check_failure_count += int(tasks is not None)
+        self._state("task", fields)
+
+    def conversation_state(self, data: JSONValue, record_count: int) -> None:
+        mapping = _mapping(_mapping(data).get("mapping"))
+        role_counts: dict[str, int] = {}
+        content_counts: dict[str, int] = {}
+        status_counts: dict[str, int] = {}
+        message_count = terminal_count = terminal_text_count = end_turn_count = image_count = 0
+        for node in mapping.values():
+            message = _mapping(_mapping(node).get("message"))
+            if not message:
+                continue
+            message_count += 1
+            role = _label(_mapping(message.get("author")).get("role"), ROLES)
+            content = _mapping(message.get("content"))
+            content_type = _label(content.get("content_type"), CONTENT_TYPES)
+            status = _label(message.get("status"), STATUSES)
+            for counts, label in ((role_counts, role), (content_counts, content_type), (status_counts, status)):
+                counts[label] = counts.get(label, 0) + 1
+            end_turn = message.get("end_turn") is True
+            terminal = end_turn or status in ("finished_successfully", "finished_partial_completion", "completed", "failed", "cancelled")
+            end_turn_count += int(role == "assistant" and end_turn)
+            terminal_count += int(role == "assistant" and terminal)
+            terminal_text_count += int(role == "assistant" and terminal and content_type == "text")
+            if role in ("assistant", "tool"):
+                image_count += _image_structure_count([message.get("content"), message.get("metadata")])
+        self._state("conversation", {
+            "conversation_query": "ok", "mapping_count": len(mapping), "message_count": message_count,
+            "role_counts": role_counts, "content_type_counts": content_counts, "message_status_counts": status_counts,
+            "assistant_end_turn_count": end_turn_count, "assistant_terminal_count": terminal_count,
+            "assistant_terminal_text_count": terminal_text_count, "image_structure_count": image_count,
+            "extracted_record_count": record_count, "file_count": self.file_count, "sediment_count": self.sediment_count,
+        })
+
+    def conversation_error(self, exc: Exception) -> None:
+        self.conversation_query_failure_count += 1
+        error = self.error_fields(exc)
+        self._state("conversation", {
+            "conversation_query": "error", "error_type": error["error_type"], "status_code": error["status_code"],
+        })
+
+    def finish(self, outcome: Literal["success", "timeout", "policy", "upstream_error"]) -> None:
+        self.logger.info({
+            **{f"task_{key}" if key in ("error_type", "status_code", "error_stage") else key: value
+               for key, value in self._states.get("task", {}).items()},
+            **{f"conversation_{key}" if key in ("error_type", "status_code") else key: value
+               for key, value in self._states.get("conversation", {}).items()},
+            "event": "image_poll_summary", "conversation_id": self.conversation_id,
+            "outcome": outcome, "attempts_made": self.attempt,
+            "file_count": self.file_count, "sediment_count": self.sediment_count,
+            "task_query_failure_count": self.task_query_failure_count,
+            "task_check_failure_count": self.task_check_failure_count,
+            "task_error_observed_count": self.task_error_observed_count,
+            "conversation_query_failure_count": self.conversation_query_failure_count,
+        })
